{% extends 'base.html.j2' %}
{% block head_meta %}
  {% set canonical_url = public_site_url ~ guide_path ~ 'comparisons/' %}
  {% set page_description = 'Endorsements side by side, surfacing tension.' %}
  {{ shell.social_meta(document_title, page_description, canonical_url) }}
{% endblock %}
{% block body %}
  {% from '_filter_controls.html.j2' import election_controls %}
  <a class="skip-link" href="#comparison-main">Skip to content</a>
  <div class="page" data-comparison-page data-election-id="{{ guide.metadata.election_id }}">
    <header>
      {{ shell.band(guide_href=guide_path, sources_href=guide_path ~ 'sources/', compare_href=guide_path ~ 'comparisons/', current='comparisons') }}
      <div class="page-band-rule"></div>
    </header>
    {{ election_day_banner | safe }}
    <main id="comparison-main" class="comparison-main">
      {%+ call shell.page_head('Comparisons', eyebrow=election_display_name) %}Endorsements side by side, surfacing tension.{% endcall +%}
      <div class="comparison-intro-wrap">
        <div class="comparison-intro">
          <div class="comparison-presets" role="group" aria-label="Suggested comparisons">
            <span>Try a comparison</span>
            {% for label, fragment in comparison_presets %}<a href="#{{ fragment }}">{{ label }}</a>{% endfor %}
          </div>
        </div>
      </div>

      <div class="sticky-header" data-sticky-controls>
      {% call election_controls(
        'Comparison view and race filters', 'comparison-controls',
        'comparison-ballot-filter', 'data-comparison-section-filter', '',
        'comparison-view', [
          {'value': 'full', 'label': 'Full', 'id': '', 'attributes': 'data-comparison-full', 'checked': true},
          {'value': 'differing', 'label': 'Differing', 'id': '', 'attributes': 'data-comparison-differences', 'checked': false}
        ],
        'comparison-races', [
          {'value': 'all', 'label': 'All', 'id': '', 'attributes': 'data-comparison-all-races', 'checked': true},
          {'value': 'contested', 'label': 'Contested', 'id': '', 'attributes': 'data-comparison-contested', 'checked': false}
        ],
        '', 'aria-atomic="true" data-comparison-status', 'comparison-control-status',
        comparison_race_count ~ ' of ' ~ comparison_race_count ~ ' races shown · ' ~ comparison_differ_count ~ ' differ'
      ) %}
        <option value="all">All Seattle ballot races</option>
        {% for section in comparison_sections %}<option value="{{ section.section_id }}">{{ section.section_label }}</option>{% endfor %}
      {% endcall %}
      </div>
      <div class="comparison-content">
        <p class="comparison-hidden-notice" role="status" aria-live="polite" data-comparison-hidden-notice hidden></p>
        {# Revealed only when the embedded payload cannot be read or names a schema
           version this build does not understand; the server-rendered table below
           stands unchanged (docs/FRONTEND.md, The data contract). #}
        <p class="comparison-hidden-notice" role="status" aria-live="polite" data-payload-notice hidden></p>
        <p class="comparison-scroll-hint" data-comparison-scroll-hint aria-hidden="true" hidden></p>
        <div class="comparison-table-wrap" data-comparison-grid role="region"
          aria-label="Scrollable endorsement comparison" tabindex="-1">
          <table class="comparison-table" data-comparison-table data-default-columns="gall,strn,stim">
          <caption class="visually-hidden">Endorsement comparison by race. On narrow screens, scroll horizontally to see additional comparison columns.</caption>
          <thead data-comparison-head>
            <tr>
              <th scope="col">Race</th>
              <th scope="col" data-column-signal="gall"><strong>All sources</strong></th>
              <th scope="col" data-column-signal="strn"><strong>{{ comparison_source_labels['strn'] }}</strong></th>
              <th scope="col" data-column-signal="stim"><strong>{{ comparison_source_labels['stim'] }}</strong></th>
            </tr>
          </thead>
          {% for section in comparison_sections %}
          <tbody data-comparison-section="{{ section.section_id }}">
            <tr class="comparison-section-heading">
              <th scope="rowgroup" colspan="4">{{ section.section_label }}</th>
            </tr>
            {% for row in section.rows %}
            <tr data-comparison-race="{{ row.race_id }}" data-row-differs="{{ row.differs | lower }}">
              <th scope="row" class="comparison-race">
                <a href="{{ guide_path }}#race-{{ row.race_id }}">{{ row.race_label }}</a>
                {% if row.differs %}<span class="comparison-race-differs">Differs</span>{% endif %}
              </th>
              {% for cell in row.cells %}
              <td class="comparison-cell" data-column-signal="{{ cell.signal }}"
                data-column-label="{% if cell.signal == 'gall' %}All sources{% else %}{{ comparison_source_labels[cell.signal] }}{% endif %}"
                data-cell-kind="{{ cell.kind }}"
                data-agreement="{% if loop.first %}reference{% else %}{{ cell.agreement }}{% endif %}"
                data-leading-pick-ids='{{ cell.leading_pick_ids | list | tojson }}'
                {% if cell.share is not none %}data-share="{{ cell.share }}"{% endif %}
                {% if cell.explicit_source_count is not none %}data-explicit-source-count="{{ cell.explicit_source_count }}"{% endif %}>
                <span class="comparison-cell-picks">
                  {% if cell.kind == 'outside_scope' %}Outside district
                  {% elif cell.choice_labels %}{{ cell.choice_labels | join(' / ') }}
                {% else %}<span title="No endorsement published">&mdash;</span>{% endif %}
                </span>
                {% if cell.kind == 'baseline' and cell.share is not none %}
                <span class="comparison-cell-meta">{{ comparison_percentage_label(cell.share) }} ·
                  {{ cell.explicit_source_count }} sources</span>
                {% endif %}
              </td>
              {% endfor %}
            </tr>
            {% endfor %}
          </tbody>
          {% endfor %}
          </table>
        </div>
      </div>

    </main>
    <footer class="site-footer">
      {% if project_url is not none %}{{ shell.election_footer_band(project_url, guide.metadata, guide_path, footer_data_updated_date, footer_site_updated_date) }}{% endif %}
    </footer>
  </div>
{% endblock %}
{% block scripts %}
  {# One payload element per page, built by rendering/payload.py from the Pydantic
     models the client's declarations are generated from (docs/FRONTEND.md, The
     data contract). #}
  <script type="application/json" data-client-payload>{{ client_payload | tojson }}</script>
  <script type="module">
{{ compare_entry_script | safe }}
  ComparePage.boot();
  </script>
{% endblock %}
