{% macro control_bar(aria_label, extra_class='', compact=false) -%}
<section{% if compact | default(false) %} data-compact-filters{% endif %} class="{% if extra_class %}{{ extra_class }} {% endif %}filter-control-bar" aria-label="{{ aria_label }}">
  {{ caller() }}
</section>
{%- endmacro %}

{% macro labeled_select(label, select_id, attributes='', extra_class='') -%}
<div class="filter-select-control{% if extra_class %} {{ extra_class }}{% endif %}">
  <label class="filter-control-label" for="{{ select_id }}">{{ label }}</label>
  <select class="filter-select" id="{{ select_id }}"{% if attributes %} {{ attributes | safe }}{% endif %}>
    {{ caller() }}
  </select>
</div>
{%- endmacro %}

{% macro segmented_radio(label, name, options, extra_class='', aligned=false) -%}
<{% if aligned %}div role="group" aria-label="{{ label }}"{% else %}fieldset{% endif %} class="filter-segmented-control{% if extra_class %} {{ extra_class }}{% endif %}" data-option-count="{{ options | length }}">
  <{% if aligned %}span{% else %}legend{% endif %} class="filter-control-label">{{ label }}</{% if aligned %}span{% else %}legend{% endif %}>
  <div class="segmented-control">
    {% for option in options -%}
    <label><input type="radio" name="{{ name }}" value="{{ option.value }}"{% if option.id %} id="{{ option.id }}"{% endif %}{% if option.attributes %} {{ option.attributes | safe }}{% endif %}{% if option.checked %} checked{% endif %}><span>{{ option.label }}</span></label>
    {%- endfor %}
  </div>
</{% if aligned %}div{% else %}fieldset{% endif %}>
{%- endmacro %}

{% macro control_status(status_id='', attributes='', extra_class='') -%}
<p class="filter-control-status{% if extra_class %} {{ extra_class }}{% endif %}"{% if status_id %} id="{{ status_id }}"{% endif %} role="status" aria-live="polite"{% if attributes %} {{ attributes | safe }}{% endif %}>{{ caller() }}</p>
{%- endmacro %}

{# One election-control composition shared by every election view. Pages may
   supply their ballot options and binary View values, but not rearrange or
   replace its slots. Admitted general precinct views use the approved compact
   Precinct / View / Races / Ballot composition; other views keep the legacy row. #}
{% macro election_controls(
  aria_label,
  extra_class,
  ballot_id,
  ballot_attributes,
  ballot_extra_class,
  view_name,
  view_options,
  race_name,
  race_options,
  status_id='',
  status_attributes='',
  status_extra_class='',
  status_text='',
  precinct_enabled=false
) -%}
{% set ballot_options = caller() %}
{% call control_bar(aria_label, extra_class, precinct_enabled) %}
  {% if precinct_enabled %}
  <div class="compact-filter-controls">
  {% include '_precinct_control.html.j2' %}
  <div class="compact-filter-slot" data-filter-trigger="view"></div>
  <div class="compact-filter-slot" data-filter-trigger="races"></div>
  <div class="compact-filter-slot" data-filter-trigger="ballot"></div>
  </div>
  <dialog id="compact-view-dialog" class="compact-filter-dialog" data-filter-editor="view" aria-labelledby="compact-view-title">
    <h2 id="compact-view-title">View</h2>
    {{ segmented_radio('View', view_name, view_options, 'view-setting', true) }}
    <button type="button" data-filter-cancel>Cancel</button>
  </dialog>
  <dialog id="compact-races-dialog" class="compact-filter-dialog" data-filter-editor="races" aria-labelledby="compact-races-title">
    <h2 id="compact-races-title">Races</h2>
    {{ segmented_radio('Races', race_name, race_options, 'view-setting', true) }}
    <button type="button" data-filter-cancel>Cancel</button>
  </dialog>
  <dialog id="compact-ballot-dialog" class="compact-filter-dialog" data-filter-editor="ballot" aria-labelledby="compact-ballot-title">
    <h2 id="compact-ballot-title">Ballot</h2>
    {% call labeled_select('Ballot', ballot_id, ballot_attributes, ballot_extra_class) %}{{ ballot_options | safe }}{% endcall %}
    <button type="button" data-filter-cancel>Cancel</button>
  </dialog>
  {% else %}
  {% call labeled_select('Ballot', ballot_id, ballot_attributes, ballot_extra_class) %}{{ ballot_options | safe }}{% endcall %}
  {{ segmented_radio('View', view_name, view_options, 'view-setting', precinct_enabled) }}
  {{ segmented_radio('Races', race_name, race_options, 'view-setting', precinct_enabled) }}
  {% endif %}
  {% call control_status(status_id, status_attributes, status_extra_class) %}{{ status_text }}{% endcall %}
{% endcall %}
{%- endmacro %}
