{% macro control_bar(aria_label, extra_class='', compact=false, sources=false) -%}
<section{% if compact | default(false) %} data-compact-filters{% endif %}{% if sources %} data-compact-sources{% endif %} class="{% if extra_class %}{{ extra_class }} {% endif %}filter-control-bar" aria-label="{{ aria_label }}">
  {{ caller() }}
</section>
{%- endmacro %}

{% macro labeled_select(label, select_id, attributes='', extra_class='') -%}
<div class="filter-select-control{% if extra_class %} {{ extra_class }}{% endif %}">
  <label class="filter-control-label" for="{{ select_id }}">{{ label }}</label>
  <select class="filter-select" id="{{ select_id }}"{% if attributes %} {{ attributes | safe }}{% endif %}>
    {{ caller() }}
  </select>
</div>
{%- endmacro %}

{% macro segmented_radio(label, name, options, extra_class='', aligned=false) -%}
<{% if aligned %}div role="group" aria-label="{{ label }}"{% else %}fieldset{% endif %} class="filter-segmented-control{% if extra_class %} {{ extra_class }}{% endif %}" data-option-count="{{ options | length }}">
  <{% if aligned %}span{% else %}legend{% endif %} class="filter-control-label">{{ label }}</{% if aligned %}span{% else %}legend{% endif %}>
  <div class="segmented-control">
    {% for option in options -%}
    <label><input type="radio" name="{{ name }}" value="{{ option.value }}"{% if option.id %} id="{{ option.id }}"{% endif %}{% if option.attributes %} {{ option.attributes | safe }}{% endif %}{% if option.checked %} checked{% endif %}><span>{{ option.label }}</span></label>
    {%- endfor %}
  </div>
</{% if aligned %}div{% else %}fieldset{% endif %}>
{%- endmacro %}

{% macro control_status(status_id='', attributes='', extra_class='') -%}
<p class="filter-control-status{% if extra_class %} {{ extra_class }}{% endif %}"{% if status_id %} id="{{ status_id }}"{% endif %} role="status" aria-live="polite"{% if attributes %} {{ attributes | safe }}{% endif %}>{{ caller() }}</p>
{%- endmacro %}

{% macro compact_select(role, label, select_id, attributes='', name='') -%}
<div class="compact-filter-slot" data-filter-trigger="{{ role }}">
  <div class="compact-filter-trigger">
    <span class="compact-filter-face" data-filter-face="{{ role }}" aria-hidden="true"></span>
    <label class="visually-hidden" for="{{ select_id }}">{{ label }}</label>
    <select class="filter-select compact-native-select" id="{{ select_id }}" data-filter-native="{{ role }}" data-filter-open="{{ role }}"{% if name %} name="{{ name }}"{% endif %}{% if attributes %} {{ attributes | safe }}{% endif %}>{{ caller() }}</select>
  </div>
</div>
{%- endmacro %}

{# One election-control composition shared by every election view. Pages may
   supply their ballot options and binary View values, but not rearrange or
   replace its slots. Current list views use the approved compact composition. The optional
   Precinct slot requires an independently admitted election capability. #}
{% macro election_controls(
  aria_label,
  extra_class,
  ballot_id,
  ballot_attributes,
  ballot_extra_class,
  view_name,
  view_options,
  race_name,
  race_options,
  status_id='',
  status_attributes='',
  status_extra_class='',
  status_text='',
  precinct_enabled=false,
  precinct_address_enabled=false,
  sources_count=none,
  sources_href=''
) -%}
{% set ballot_options = caller() %}
{% call control_bar(aria_label, extra_class, true, sources_count is not none) %}
  <div class="compact-filter-controls">
  {% if precinct_enabled %}{% include '_precinct_control.html.j2' %}{% endif %}
  {% call compact_select('view', 'View', 'compact-view-select', name=view_name) %}
    {% for option in view_options %}<option value="{{ option.value }}"{% if option.id %} id="{{ option.id }}"{% endif %}{% if option.attributes %} {{ option.attributes | safe }}{% endif %}{% if option.checked %} selected{% endif %}>{{ option.label }}</option>{% endfor %}
  {% endcall %}
  {% call compact_select('races', 'Races', 'compact-races-select', name=race_name) %}
    {% for option in race_options %}<option value="{{ option.value }}"{% if option.id %} id="{{ option.id }}"{% endif %}{% if option.attributes %} {{ option.attributes | safe }}{% endif %}{% if option.checked %} selected{% endif %}>{{ option.label }}</option>{% endfor %}
  {% endcall %}
  {% call compact_select('ballot', 'Ballot', ballot_id, ballot_attributes) %}{{ ballot_options | safe }}{% endcall %}
  </div>
  {% if sources_count is not none %}
  <div class="compact-source-row">
  <div class="compact-source-slot" data-lens-banner>
    <span class="visually-hidden" data-lens-banner-status role="status" aria-live="polite">Counting all {{ sources_count }} sources.</span>
    <a class="compact-source-link" data-sources-link href="{{ sources_href }}" aria-label="Edit sources. Counting all {{ sources_count }} sources.">
      <svg class="compact-filter-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 4h6v6H4zM14 4h6v6h-6zM4 14h6v6H4zM14 14h6v6h-6z"/></svg>
      <span class="compact-source-label">Sources: <span data-sources-summary>All {{ sources_count }}</span></span>
      <svg class="compact-filter-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6"/></svg>
    </a>
  </div>
  {% endif %}
  {% call control_status(status_id, status_attributes, status_extra_class) %}{{ status_text }}{% endcall %}
  {% if sources_count is not none %}</div>{% endif %}
{% endcall %}
{%- endmacro %}
