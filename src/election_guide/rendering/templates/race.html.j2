{# One race's own page (issue #136).

   This carries what the guide's race-detail dialog carried, at an address a
   reader can land on, share, and unfurl — which is the test DESIGN.md's
   page-vs-modal rule says to re-run when requirements change, and this is the
   answer it now gives.

   Server rendered in full, so the page stands alone for a crawler and for a
   reader without JavaScript. Three regions are lit's while a lens is active:
   the headline's result, caption, and foot (the guide card's own components,
   from `guide-card.mjs`), and the candidate sections (`race-detail.mjs`). Each
   is one element the server already renders, whose children lit takes over
   once the reader's selection stops being the audited default
   (docs/FRONTEND.md § Rendering). #}
{% extends 'base.html.j2' %}
{% block head_meta %}
  {% set canonical_url = public_site_url ~ race_path %}
  {{ shell.social_meta(document_title, page_description, canonical_url) }}
{% endblock %}
{% block body %}
  {% macro source_badge(row) -%}
    <span class="race-detail-category-badge">{{ row.category_label }}</span>
  {%- endmacro %}
  {% macro source_count_phrase(count, group_key=none) -%}
    {{ count }} source{% if count != 1 %}s{% endif %}{% if group_key == 'not_covered' %} did not cover this race{% elif group_key == 'not_applicable' %} {% if count == 1 %}was{% else %}were{% endif %} outside this district{% endif %}
  {%- endmacro %}
  {% macro source_row(row, group_key, candidate_id=none) -%}
    <li data-race-detail-source-code="{{ row.code }}"
      data-source-category="{{ row.category }}" data-source-state="{{ row.state }}"
      data-source-role="{{ row.panel_role }}" data-source-group="{{ group_key }}"
      {%- if candidate_id is not none %} data-endorsed-candidate-id="{{ candidate_id }}"{% endif %}>
      {% if row.evidence_url %}<a class="race-detail-source-row" href="{{ row.evidence_url }}"{{ external_link_attributes }}>
      {% else %}<div class="race-detail-source-row">
      {% endif %}
        <strong>{{ row.name }}</strong>
        <div class="race-detail-source-meta">
          {{ source_badge(row) }}
          {% if row.detail_label %}<span class="race-detail-source-status">{{ row.detail_label }}</span>{% endif %}
        </div>
      {% if row.evidence_url %}</a>{% else %}</div>{% endif %}
    </li>
  {%- endmacro %}
  {% macro group_source_rows(group_key) -%}
    <ul class="race-detail-source-list">
      {% for row in group_rows[group_key] %}{{ source_row(row, group_key) }}{% endfor %}
    </ul>
  {%- endmacro %}
  {# The audited candidate sections. lit renders this same shape from the same
     payload while a lens is active, and `race-markup-parity.test.mjs` diffs the
     two, so a change here is a change there. #}
  {# The candidate the headline already names, or `none` when the headline names
     no single one. Passed in rather than read from the template scope so the
     macro's inputs are its arguments, as `source_row`'s are. #}
  {% macro candidate_sections(headline_candidate_id) -%}
    {% for candidate in race_detail.candidates %}
    {% set is_leader = candidate.candidate_id in race.support_leader_candidate_ids %}
    {# Three treatments, and a candidate takes exactly one of them:

       - the headline's own candidate renders no heading, because the headline
         above is its heading and a page names a candidate once;
       - a tied leader renders an amber heading with its own eyebrow and meter,
         because a tie is a warning to choose rather than a favourite to
         endorse, and every tied candidate is equally the answer; and
       - everyone else renders an amber heading with just their name. #}
    {% set in_headline = candidate.candidate_id == headline_candidate_id %}
    {% set tied = is_leader and not in_headline %}
    <section class="race-detail-candidate{% if in_headline %} race-detail-candidate-leader race-detail-candidate-headlined{% elif tied %} race-detail-candidate-tied{% endif %}"
      data-race-detail-candidate-id="{{ candidate.candidate_id }}">
      {% if not in_headline %}
      <div class="race-detail-candidate-heading">
        <div class="race-detail-candidate-title">
          {% if tied %}
          <p>Tied for lead</p>
          {% endif %}
          <h4>{{ candidate.label }}</h4>
        </div>
        {# No count here. Every endorsing source this candidate has is listed
           immediately below, so a number naming how many would restate the list
           it sits on top of. What the heading carries is what the list cannot:
           the share, and only where a share is contested. #}
        {% if tied %}
        <div class="race-detail-candidate-metrics">
          {% if race.percentage_whole is none %}
          <div class="race-detail-meter race-detail-meter-na" role="img"
            aria-label="{{ screen_share_accessible_label(race) }}"><strong>N/A</strong></div>
          {% else %}
          <div class="race-detail-meter{% if has_no_majority(race) %} meter-no-majority{% endif %}{% if race.percentage_whole < 30 %} meter-low-fill{% endif %}" style="--meter-fill: {{ race.percentage_whole }}%"
            role="img" aria-label="{{ screen_share_accessible_label(race) }}">
            <strong>{{ race.percentage_label }}</strong>
          </div>
          {% endif %}
        </div>
        {% endif %}
      </div>
      {% endif %}
      <ul class="race-detail-source-list">
        {% for row in candidate.endorsers %}{{ source_row(row, 'candidate', candidate.candidate_id) }}{% endfor %}
      </ul>
    </section>
    {% endfor %}
  {%- endmacro %}

  {# One recommendation means one leading choice, and the headline is that
     candidate's own header. A tie recommends two and reads "A / B", so no
     single section is the headline's and each keeps its heading. #}
  {% set headline_candidate_id = race.recommendation_candidate_ids[0]
     if race.recommendation_candidate_ids | length == 1 else none %}

  <a class="skip-link" href="#race-detail">Skip to endorsements</a>

  <div class="page screen-race">
    <header>
      {{ shell.band(guide_href=guide_path, sources_href=sources_page_url, compare_href=compare_href, current='endorsements', sources_link_data_attribute=true) }}
      <div class="page-band-rule"></div>
    </header>
    {{ election_day_banner | safe }}
    {%+ call shell.page_head(race.race_label, eyebrow=election_display_name) %}Every endorsement that matters, with receipts.{% endcall +%}

    {# The same strip the guide renders, for the same reason: a reader who
       arrived under a personalized selection has to see what is being counted,
       and be able to change it without losing their place. Its two announcing
       elements stay the server's for the life of the page — lit renders their
       text, never the elements (docs/FRONTEND.md § Rendering). #}
    {% if guide.personalization.policy.enabled %}
    <div class="lens-banner state-action-strip" data-lens-banner>
      <span data-lens-banner-status role="status" aria-live="polite">Counting all {{ consensus_source_count }} sources.</span>
      <a data-sources-link href="{{ sources_page_url }}">Edit sources</a>
    </div>
    {% endif %}
    <p class="lens-notice" data-lens-notice hidden role="status" aria-live="polite"></p>
    <p class="lens-notice" data-payload-notice hidden role="status" aria-live="polite"></p>

    <main id="race-detail" class="race-detail" data-publication-race-id="{{ race.id }}">
      {# The headline names the one clear favourite, in the card's own components
         so the reader sees the quantity they clicked, larger. It is that
         candidate's heading — the section below renders none — so it appears
         only when the race has a single leading choice.

         A tie renders no headline at all. Naming both candidates here would
         list each of them twice on one page, and the green this block wears
         says "clear favourite", which is the opposite of what a tie is: a
         warning that the reader has to choose. Tied candidates carry their own
         amber sections instead, each with its own meter and eyebrow.

         Hidden rather than absent, because a lens can turn a tie into a sole
         leader: the element the client fills has to be here to fill. #}
      <div class="race-headline{% if headline_candidate_id is not none %} race-headline-heads-section{% endif %}"
        role="group" aria-label="Consensus result"
        aria-describedby="race-consensus-summary" data-race-headline
        {%- if headline_candidate_id is none %} hidden{% endif %}>
        <p class="race-headline-eyebrow">Leading choice</p>
        <div class="screen-race-result" data-lens-result>
          <h3 data-display-role="recommendation">{{ race.recommendation_label }}</h3>
          {% if race.percentage_whole is none %}
          <div class="screen-meter screen-meter-na" role="img" data-display-role="share"
            aria-label="{{ screen_share_accessible_label(race) }}">
            <strong>N/A</strong>
          </div>
          {% else %}
          <div class="screen-meter{% if has_no_majority(race) %} meter-no-majority{% endif %}{% if race.percentage_whole < 30 %} meter-low-fill{% endif %}" style="--meter-fill: {{ race.percentage_whole }}%"
            role="img" data-display-role="share"
            aria-label="{{ screen_share_accessible_label(race) }}">
            <strong>{{ race.percentage_label }}</strong>
          </div>
          {% endif %}
        </div>
        {# The card's caption is not repeated here for the same reason the
           sections carry no count: this candidate's endorsing sources are
           listed directly below the headline, so "8 of 11 endorsing sources"
           would name the length of a list the reader is already looking at. #}
        <div class="screen-race-context" data-lens-context>
          <p class="no-majority-pill"{% if not has_no_majority(race) %} hidden{% endif %}>No majority</p>
        </div>
      </div>

      {# Both of these state something about the race rather than about its
         leading choice, so they sit outside the headline and survive a race
         that has no single leader to head one — a tie, or too few endorsements
         to measure. The summary is the page's accessible description, as it was
         the dialog's: an element the server renders and keeps, whose text the
         client recomputes under a lens. #}
      <div class="race-headline-foot" data-lens-foot>
        {% if race.grade == 'Insufficient' %}
        <div class="insufficient-note" role="note" data-display-role="insufficient-warning">
          Too few endorsements to measure agreement.</div>
        {% endif %}
      </div>
      <p id="race-consensus-summary" class="visually-hidden"
        data-race-detail-summary>{{ race_detail_accessible_summary(race) }}</p>

      <div class="race-detail-outcomes">
        {# `display: contents` (race.css), so lit owns one region without the
           sections below losing the grid gap between them. #}
        <div class="race-detail-candidates" data-race-candidates>
          {{ candidate_sections(headline_candidate_id) }}
        </div>
        {% for group_key in source_cell_group_keys %}
        {% if group_rows[group_key] %}
        <section class="race-detail-outcome race-detail-outcome-{{ group_key }}"
          data-race-detail-group="{{ group_key }}">
          <div class="race-detail-outcome-heading">
            <h4>{{ source_cell_group_label(race, group_key) }}</h4>
            <span>{{ source_count_phrase(group_rows[group_key] | length) }}</span>
          </div>
          {{ group_source_rows(group_key) }}
        </section>
        {% endif %}
        {% endfor %}
      </div>
      {% for group_key in ('not_covered', 'not_applicable') %}
      {% if group_rows[group_key] %}
      <details class="race-detail-missing">
        <summary>{{ source_count_phrase(group_rows[group_key] | length, group_key) }}</summary>
        {{ group_source_rows(group_key) }}
      </details>
      {% endif %}
      {% endfor %}
    </main>

    <footer class="site-footer">
      {% if project_url is not none %}{{ shell.election_footer_band(project_url, guide.metadata, guide_path, footer_data_updated_date, footer_site_updated_date) }}{% endif %}
    </footer>
  </div>
{% endblock %}
{% block scripts %}

  {# One payload element per page, built by rendering/payload.py from the
     Pydantic models the client's declarations are generated from
     (docs/FRONTEND.md, The data contract). #}
  <script type="application/json" data-client-payload>{{ client_payload | tojson }}</script>
  <script type="module">
{{ race_entry_script | safe }}
  RacePage.boot();
  </script>
{% endblock %}
