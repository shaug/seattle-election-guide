<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="author" content="{{ config.author }}">
  <meta name="description" content="{{ config.subject }}">
  {% set canonical_url = config.public_site_url ~ '/e/' ~ guide.metadata.election_id ~ '/' %}
  <meta property="og:type" content="website">
  <meta property="og:title" content="{{ config.title }}">
  <meta property="og:description" content="{{ config.subject }}">
  <meta property="og:url" content="{{ canonical_url }}">
  <meta name="twitter:card" content="summary">
  <meta name="twitter:title" content="{{ config.title }}">
  <meta name="twitter:description" content="{{ config.subject }}">
  <link rel="canonical" href="{{ canonical_url }}">
  <title>{{ config.title }}</title>
  <style>{{ stylesheet | safe }}</style>
</head>
<body>
  {% macro source_participation(source, compact=false) -%}
    {% if compact %}{{ source.endorsement_count }}{% if source.panel_role == 'comparison' %} picks{% endif %} · {{ source.split_endorsement_count }} split{% else %}{% if source.panel_role == 'comparison' %}{{ source.endorsement_count }} picks{% else %}{{ source.endorsement_count }} endorsements{% endif %} · {{ source.split_endorsement_count }} split{% endif %}
  {%- endmacro %}
  {% macro source_row(source, compact=false) -%}
    <div class="source-row source-row-{{ source.panel_role }}"
      data-publication-source-id="{{ source.id }}"
      data-source-category="{{ source.category }}"
      data-source-role="{{ source.panel_role }}">
      <a href="{{ source.evidence_url }}">{{ source.name }}</a>
      <span>{{ source_participation(source, compact) }}</span>
    </div>
  {%- endmacro %}
  {% macro coverage_gap_row(source, compact=false) -%}
    <section class="coverage-gap-row"
      data-coverage-gap-source-id="{{ source.id }}"
      data-coverage-gap-status="{{ source.coverage_gap_status }}">
      <div><a href="{{ source.evidence_url }}">{{ source.name }}</a>
        <strong>{% if source.coverage_gap_status == 'access_restricted' %}Official results inaccessible{% else %}No published results found{% endif %}</strong></div>
      {% if not compact %}<p>{{ source.coverage_gap_note }}</p>{% endif %}
    </section>
  {%- endmacro %}
  {% macro sources_member_row(category, member_code) -%}
    {% set psource = personalization_source_by_code[member_code] %}
    {% set pub_source = source_by_id[psource.id] %}
    {# The comparison category's own row never starts checked and is always
       interactive (issue 96/97: showing the comparison predates and is
       independent of the personalization policy), unlike an ordinary
       tallying category's row. #}
    {% set is_comparison = category.panel_role == 'comparison' %}
    {# A source with zero endorsements this cycle (a coverage gap) has
       nothing an interactive checkbox could ever toggle into a score, so it
       stays out of this tree entirely and appears only in the coverage-gaps
       section below, matching the prior evidence directory's own
       "contributing" filter. #}
    {% if pub_source.contribution_status == 'contributing' %}
    {% set other_category_ids = psource.selection_category_ids | reject('equalto', category.id) | list %}
    <div class="sources-row" data-sources-source-row="{{ member_code }}">
      {% if is_comparison or guide.personalization.policy.enabled %}
      <label class="sources-check">
        <input type="checkbox" data-sources-source="{{ member_code }}"
          data-sources-category-member="{{ category.code }}"{% if not is_comparison %} checked{% endif %}>
        <a href="{{ pub_source.evidence_url }}">{{ pub_source.name }}</a>
      </label>
      {% else %}
      <a class="sources-source-link" href="{{ pub_source.evidence_url }}">{{ pub_source.name }}</a>
      {% endif %}
      <span class="sources-count">{{ source_participation(pub_source) }}</span>
      {% if other_category_ids %}
      <span class="sources-also-in">also in:
        {%- for other_id in other_category_ids %} {{ category_label_by_id[other_id] }}{% if not loop.last %},{% endif %}{% endfor -%}
      </span>
      {% endif %}
    </div>
    {% endif %}
  {%- endmacro %}
  {% macro race_detail_source_badge(source) -%}
    <span class="race-detail-category-badge">{{ source_category_label_by_key[source.category] }}</span>
    {% if source.panel_role == 'comparison' %}
    <span class="race-detail-comparison-badge">Comparison only</span>
    {% endif %}
  {%- endmacro %}
  {% macro source_count_phrase(count, group_key=none) -%}
    {{ count }} source{% if count != 1 %}s{% endif %}{% if group_key == 'not_covered' %} did not cover this race{% elif group_key == 'not_applicable' %} {% if count == 1 %}was{% else %}were{% endif %} outside this district{% endif %}
  {%- endmacro %}
  {% macro times_source_counts(shown, total, group_key=none) -%}
    <span data-times-hidden>{{ source_count_phrase(shown, group_key) }}</span><span data-times-only>{{ source_count_phrase(total, group_key) }}</span>
  {%- endmacro %}
  {% macro race_detail_source_rows(race, group_key) -%}
    <ul class="race-detail-source-list">
      {% for cell in race.source_cells %}
      {% set source = source_by_id[cell.source_id] %}
      {% if source_cell_group(cell, race, source) == group_key %}
      {% set detail_label = source_cell_detail_label(cell, race, group_key) %}
      <li data-race-detail-source-id="{{ cell.source_id }}"
        data-source-category="{{ source.category }}" data-source-state="{{ cell.state }}"
        data-source-role="{{ source.panel_role }}" data-source-group="{{ group_key }}">
        {% if cell.evidence_url %}<a class="race-detail-source-row{% if source.panel_role == 'comparison' %} race-detail-source-row-comparison{% endif %}" href="{{ cell.evidence_url }}">
        {% else %}<div class="race-detail-source-row{% if source.panel_role == 'comparison' %} race-detail-source-row-comparison{% endif %}">
        {% endif %}
          <strong>{{ source.name }}</strong>
          <div class="race-detail-source-meta">
            {{ race_detail_source_badge(source) }}
            {% if detail_label %}<span class="race-detail-source-status">{{ detail_label }}</span>{% endif %}
          </div>
        {% if cell.evidence_url %}</a>{% else %}</div>{% endif %}
      </li>
      {% endif %}
      {% endfor %}
    </ul>
  {%- endmacro %}
  {% macro race_detail_candidate_source_row(race, cell, candidate_id) -%}
    {% set source = source_by_id[cell.source_id] %}
    {% set detail_label = source_cell_detail_label(cell, race, 'candidate') %}
    <li data-race-detail-source-id="{{ cell.source_id }}"
      data-source-category="{{ source.category }}" data-source-state="{{ cell.state }}"
      data-source-role="{{ source.panel_role }}" data-source-group="candidate"
      data-endorsed-candidate-id="{{ candidate_id }}">
      {% if cell.evidence_url %}<a class="race-detail-source-row{% if source.panel_role == 'comparison' %} race-detail-source-row-comparison{% endif %}" href="{{ cell.evidence_url }}">
      {% else %}<div class="race-detail-source-row{% if source.panel_role == 'comparison' %} race-detail-source-row-comparison{% endif %}">
      {% endif %}
        <strong>{{ source.name }}</strong>
        <div class="race-detail-source-meta">
          {{ race_detail_source_badge(source) }}
          {% if detail_label %}<span class="race-detail-source-status">{{ detail_label }}</span>{% endif %}
        </div>
      {% if cell.evidence_url %}</a>{% else %}</div>{% endif %}
    </li>
  {%- endmacro %}
  {% macro race_detail_candidate_sections(race) -%}
    {% for candidate_id, candidate_label, endorsement_group in race_detail_candidate_choices(race, source_by_id) %}
    {% set is_leader = candidate_id in race.support_leader_candidate_ids %}
    {% set source_count = endorsement_group.source_count if endorsement_group is not none else 0 %}
    {# A candidate only the comparison source picked has nothing to show by
       default: hiding it here, rather than only its rows, keeps the whole
       "0 endorsing sources" card out of the state this ticket makes default. #}
    <section class="race-detail-candidate{% if is_leader %} race-detail-candidate-leader{% endif %}"
      data-race-detail-candidate-id="{{ candidate_id }}"
      {% if endorsement_group is none %}data-times-only{% endif %}>
      <div class="race-detail-candidate-heading">
        <div class="race-detail-candidate-title">
          {% if is_leader %}<p>{% if race.support_leader_candidate_ids | length > 1 %}Tied for lead{% else %}Leading choice{% endif %}</p>{% endif %}
          <h4>{{ candidate_label }}</h4>
        </div>
        <div class="race-detail-candidate-metrics">
          <span>{% if is_leader and race.recommendation_candidate_ids | length == 1 %}{{ source_count }} of {{ race.explicit_endorsement_count }} endorsing sources{% else %}{{ source_count }} endorsing source{% if source_count != 1 %}s{% endif %}{% endif %}</span>
          {% if is_leader %}
            {% if race.percentage_whole is none %}
            <div class="race-detail-meter race-detail-meter-na" role="img"
              aria-label="{{ screen_share_accessible_label(race) }}"><strong>N/A</strong></div>
            {% else %}
            <div class="race-detail-meter" style="--meter-fill: {{ race.percentage_whole }}%"
              role="img" aria-label="{{ screen_share_accessible_label(race) }}">
              <strong>{{ race.percentage_label }}</strong>
            </div>
            {% endif %}
          {% endif %}
        </div>
      </div>
      <ul class="race-detail-source-list">
        {% if endorsement_group is not none %}
        {% for endorser in endorsement_group.endorsers %}
        {% set cell = source_cells_by_race_id[race.id][endorser.source_id] %}
        {{ race_detail_candidate_source_row(race, cell, candidate_id) }}
        {% endfor %}
        {% endif %}
        {% for cell in comparison_candidate_cells(race, source_by_id, candidate_id) %}
        {{ race_detail_candidate_source_row(race, cell, candidate_id) }}
        {% endfor %}
      </ul>
    </section>
    {% endfor %}
  {%- endmacro %}
  {% set election_display_label = 'August 2026 Primary' %}
  {% set contributing_sources = guide.sources | selectattr('contribution_status', 'equalto', 'contributing') | list %}
  {% set coverage_gap_sources = guide.sources | selectattr('contribution_status', 'equalto', 'coverage_gap') | list %}
  <a class="skip-link" href="#guide-races">Skip to recommendations</a>

  <main class="screen-guide">
    <header class="hero">
      <div class="hero-copy">
        <div class="hero-kicker">{{ election_display_label }}</div>
        <h1>Seattle Progressive Endorsement Guide</h1>
        <p class="hero-deck">Progressive endorsement agreement at a glance. The Seattle
          Times is an optional comparison you can turn on under
          <b>Sources</b>.</p>
      </div>
      <div class="hero-meta" aria-label="Guide metadata">
        <span>Election {{ guide.metadata.election_date }}</span>
        <span>{{ guide.metadata.published_race_count }} races</span>
      </div>
    </header>

    <section class="screen-controls" aria-label="Guide view and race filters">
      <div class="race-filter-control">
        <label for="race-filter">Show races</label>
        <select id="race-filter">
          <option value="all">All Seattle ballot races</option>
          <optgroup label="Ballot sections">
          {% for section in guide.sections %}
          <option value="{{ section.id }}">{{ section.label }}</option>
          {% endfor %}
          </optgroup>
          <optgroup label="Districts and jurisdictions">
          {% for option in filter_options %}<option value="{{ option }}">{{ option }}</option>{% endfor %}
          </optgroup>
        </select>
      </div>
      <fieldset class="view-setting">
        <legend>View</legend>
        <div class="segmented-control">
          <label><input type="radio" name="ballot-view" value="full" checked><span>Full</span></label>
          <label><input type="radio" name="ballot-view" value="compact"><span>Compact</span></label>
        </div>
      </fieldset>
      <fieldset class="view-setting">
        <legend>Races</legend>
        <div class="segmented-control">
          <label><input type="radio" name="race-set" value="complete" id="complete-filter" checked><span>Complete</span></label>
          <label><input type="radio" name="race-set" value="contested" id="contested-filter"><span>Contested</span></label>
        </div>
      </fieldset>
      <p id="filter-status" role="status" aria-live="polite"></p>
    </section>

    {% if guide.personalization.policy.enabled %}
    <p class="lens-banner" data-lens-banner hidden role="status" aria-live="polite"></p>
    <p class="lens-notice" data-lens-notice hidden role="status" aria-live="polite"></p>
    {% endif %}

    <div id="guide-races" class="screen-sections">
      {% for section in guide.sections %}
      <section class="screen-section" data-filter-section="{{ section.id }}">
        <div class="section-heading">
          <p>Ballot section</p>
          <h2>{{ section.label }}</h2>
        </div>
        <div class="race-grid">
          {% for race in section.races %}
          <article class="race-card" id="race-{{ race.id }}"
            data-publication-race-id="{{ race.id }}"
            data-contested="{{ 'true' if race.is_contested else 'false' }}"
            aria-labelledby="race-label-{{ race.id }}"
            data-filter-tokens='{{ race.filter_tokens | tojson }}'>
            <a class="race-card-primary" href="#race-{{ race.id }}" data-race-detail-link
              aria-label="View endorsements for {{ race.race_label }}"
              aria-haspopup="dialog" aria-controls="race-detail-{{ race.id }}">
              <p class="race-office">
                <span id="race-label-{{ race.id }}"
                  data-display-role="race-label">{{ race.race_label }}</span>
                {% if guide.personalization.policy.enabled %}<span class="lens-card-badge" data-lens-only data-lens-card-badge>My sources</span>{% endif %}
              </p>
              <div class="screen-race-result">
                <h3 data-display-role="recommendation"{% if guide.personalization.policy.enabled %} data-lens-hidden{% endif %}>{{ race.recommendation_label }}</h3>
                {% if guide.personalization.policy.enabled %}
                <h3 class="lens-value" data-lens-only data-lens-recommendation></h3>
                {% endif %}
                {% if race.percentage_whole is none %}
                <div class="screen-meter screen-meter-na" role="img" data-display-role="share"
                  aria-label="{{ screen_share_accessible_label(race) }}"{% if guide.personalization.policy.enabled %} data-lens-hidden{% endif %}>
                  <strong>N/A</strong>
                </div>
                {% else %}
                <div class="screen-meter" style="--meter-fill: {{ race.percentage_whole }}%"
                  role="img" data-display-role="share"
                  aria-label="{{ screen_share_accessible_label(race) }}"{% if guide.personalization.policy.enabled %} data-lens-hidden{% endif %}>
                  <strong>{{ race.percentage_label }}</strong>
                </div>
                {% endif %}
                {% if guide.personalization.policy.enabled %}
                <div class="screen-meter" data-lens-only data-lens-share role="img">
                  <strong data-lens-share-text></strong>
                </div>
                {% endif %}
              </div>
              <div class="screen-race-context">
                <div class="screen-comparisons">
                  {% for comparison in race.comparisons %}
                  <p class="comparison comparison-{{ comparison.voter_tone }}" role="group"
                    aria-label="{{ comparison.voter_accessible_label }}" data-display-role="comparison">
                    <strong class="comparison-status">{{ comparison.print_status_label }}</strong><span class="comparison-separator"> · </span><span class="comparison-choice">{{ comparison.print_choice_label }}</span>
                  </p>
                  {% endfor %}
                </div>
                <p class="support-line" data-display-role="support"{% if guide.personalization.policy.enabled %} data-lens-hidden{% endif %}>{{ screen_support_summary(race) }}</p>
                {% if guide.personalization.policy.enabled %}
                <p class="support-line lens-value" data-lens-only data-lens-support></p>
                {% endif %}
              </div>
            </a>
            {% if race.grade == 'Insufficient' %}
            <div class="insufficient-note" role="note" data-display-role="insufficient-warning"{% if guide.personalization.policy.enabled %} data-lens-hidden{% endif %}>
              Too few explicit endorsements to assess consensus reliably.</div>
            {% endif %}
            {% if guide.personalization.policy.enabled %}
            <div class="insufficient-note" data-lens-only data-lens-insufficient hidden>
              Too few explicit endorsements to assess consensus reliably in My sources.</div>
            <p class="lens-comparison" data-lens-only data-lens-comparison hidden></p>
            {% endif %}
            <dialog class="race-detail-dialog" id="race-detail-{{ race.id }}"
              data-race-detail-dialog data-race-id="{{ race.id }}"
              aria-labelledby="race-detail-election-{{ race.id }} race-detail-title-{{ race.id }}"
              aria-describedby="race-detail-summary-{{ race.id }}">
              <div class="race-detail-header">
                <div>
                  <p id="race-detail-election-{{ race.id }}">{{ election_display_label }} · Endorsements</p>
                  <h3 id="race-detail-title-{{ race.id }}">{{ race.race_label }}</h3>
                  <p id="race-detail-summary-{{ race.id }}" class="visually-hidden">{{ race_detail_accessible_summary(race) }}</p>
                </div>
                <div class="race-detail-actions">
                  <button type="button" data-copy-race-link="race-{{ race.id }}"
                    aria-label="Copy a share link to {{ race.race_label }}"
                    aria-describedby="copy-race-status-{{ race.id }}">Share link</button>
                  <button type="button" data-close-race-detail
                    aria-label="Close endorsements for {{ race.race_label }}">Close</button>
                </div>
                <p id="copy-race-status-{{ race.id }}" class="visually-hidden" role="status"
                  aria-live="polite" data-copy-race-status></p>
              </div>
              <div class="race-detail-body">
                {% if guide.personalization.policy.enabled %}
                <section class="race-detail-lens" data-lens-only data-race-detail-lens>
                  <h4>My sources</h4>
                  <p data-lens-detail-summary></p>
                  <p class="lens-comparison" data-lens-only data-lens-detail-audited hidden></p>
                  <ul class="lens-detail-sources" data-lens-detail-sources></ul>
                </section>
                {% endif %}
                <div class="race-detail-outcomes">
                  {{ race_detail_candidate_sections(race) }}
                  {% for group_key in source_cell_group_keys %}
                  {% set group_count = source_cell_group_count(race, source_by_id, group_key) %}
                  {% set shown_count = source_cell_group_count(race, source_by_id, group_key, include_comparison=False) %}
                  {% if group_count %}
                  <section class="race-detail-outcome race-detail-outcome-{{ group_key }}"
                    data-race-detail-group="{{ group_key }}">
                    <div class="race-detail-outcome-heading">
                      <h4>{{ source_cell_group_label(race, group_key) }}</h4>
                      <span>{{ times_source_counts(shown_count, group_count) }}</span>
                    </div>
                    {{ race_detail_source_rows(race, group_key) }}
                  </section>
                  {% endif %}
                  {% endfor %}
                </div>
                {% for group_key in ('not_covered', 'not_applicable') %}
                {% set missing_count = source_cell_group_count(race, source_by_id, group_key) %}
                {% set shown_missing = source_cell_group_count(race, source_by_id, group_key, include_comparison=False) %}
                {% if missing_count %}
                <details class="race-detail-missing">
                  <summary>{{ times_source_counts(shown_missing, missing_count, group_key) }}</summary>
                  {{ race_detail_source_rows(race, group_key) }}
                </details>
                {% endif %}
                {% endfor %}
              </div>
            </dialog>
          </article>
          {% endfor %}
        </div>
      </section>
      {% endfor %}
    </div>

    <footer class="screen-footer">
      <div class="footer-summary">
        <div>
          <p class="eyebrow">About this guide</p>
          <h2>Agreement, not a candidate grade.</h2>
        </div>
        <p>Percentages show agreement among sources that explicitly endorsed in each race.
          The Seattle Times is a separate comparison signal.</p>
        <nav class="footer-actions" aria-label="Guide links">
          <a href="{{ config.pdf_filename }}">Printable PDF</a>
          <a href="mailto:seattle-elections@dobravoda.dev">Feedback?</a>
          <a href="/about/">About &amp; FAQ</a>
          <a href="{{ config.project_url }}">Source and audit files</a>
          <button type="button" class="footer-share" data-share-guide>Share this guide</button>
          <p class="visually-hidden" role="status" aria-live="polite" data-share-guide-status></p>
        </nav>
      </div>
      <details class="guide-notes" id="methodology">
        <summary><span>Methodology</span><span aria-hidden="true">+</span></summary>
        <div class="methodology-screen">
      <section class="methodology-panel screen-consensus-key">
        <h3>Agreement, not a grade</h3>
        <p>The percentage is the leading choice's share of endorsement points among sources
          that explicitly endorsed in that race.</p>
        <p>The source count is the sample behind the percentage. Neither number rates candidate quality.</p>
      </section>
      <section class="methodology-panel">
        <h3>What enters the count</h3>
        <p>Each organization has equal weight. Multi-candidate endorsements split one point;
          no endorsement and missing coverage do not enter the percentage.</p>
        <p>Legislative-district groups count on broader races they cover, but only their own
          district's legislative contests.</p>
      </section>
      <section class="methodology-panel">
        <h3>The Times is separate and optional</h3>
        <p>Seattle Times choices are hidden by default on screen and can be shown under
          <b>Sources</b>. They are comparison only and never add a vote to the progressive
          consensus, so turning them on changes nothing that is scored.</p>
        <p>The printable guide always includes the comparison.</p>
        <p>This guide aggregates endorsements; it is not independent candidate vetting.</p>
      </section>
      <section class="methodology-panel methodology-overlap">
        <h3>Related organizations</h3>
        {% if guide.methodology.source_overlap_groups %}
          {% for group in guide.methodology.source_overlap_groups %}<p><strong>{{ group.label }}</strong>
            — {{ group.source_ids | length }} sources. These relationships are disclosed, not deduplicated.</p>{% endfor %}
        {% else %}<p>No possible overlap groups span multiple active sources.</p>{% endif %}
        <p>Organizations may update endorsements after capture, and a voter's exact ballot depends on registration address.</p>
      </section>
        </div>
      </details>
      <details class="guide-notes merged-sources" id="sources">
        <summary><span>Sources ({{ guide.metadata.contributing_source_count }})</span><span aria-hidden="true">+</span></summary>
        <div class="sources-tree">
          <div class="sources-heading">
            <div><p class="eyebrow">Evidence &amp; customization</p><h2>Sources contributing to this guide</h2></div>
            <p>Counts cover the {{ guide.metadata.published_race_count }} races shown. Split is the
              multi-candidate subset. Every source starts checked to match the audited consensus;
              uncheck any to see how your own picks compare.</p>
          </div>
          <p class="sources-comparison-status" data-sources-comparison-status role="status" aria-live="polite"></p>
          <div class="sources-columns">
            {% for category in guide.personalization.categories if category.selectable and category.panel_role != 'comparison' %}
            <section class="sources-category" data-sources-category="{{ category.code }}">
              <h3>
                {% if guide.personalization.policy.enabled %}
                <label class="sources-check sources-category-check">
                  <input type="checkbox" data-sources-category-toggle="{{ category.code }}" checked>
                  <span>{{ category.label }}</span>
                </label>
                {% else %}
                <span>{{ category.label }}</span>
                {% endif %}
              </h3>
              {% for member_code in category.member_source_codes %}
                {{ sources_member_row(category, member_code) }}
              {% endfor %}
            </section>
            {% endfor %}
          </div>

          {% set comparison_category = guide.personalization.categories | selectattr('panel_role', 'equalto', 'comparison') | first %}
          {% if comparison_category %}
          <section class="sources-category sources-category-comparison" data-sources-category="{{ comparison_category.code }}">
            <p class="sources-comparison-note">Comparison only. The Times is a comparison signal
              only: selecting it here never changes a recommendation, a count, or an agreement
              score, and it is never counted toward the tally above.</p>
            <h3>
              <label class="sources-check sources-category-check">
                <input type="checkbox" data-sources-category-toggle="{{ comparison_category.code }}">
                <span>{{ comparison_category.label }}</span>
              </label>
            </h3>
            {% for member_code in comparison_category.member_source_codes %}
              {{ sources_member_row(comparison_category, member_code) }}
            {% endfor %}
          </section>
          {% endif %}

          {% if coverage_gap_sources %}
          <section class="screen-coverage-gaps">
            <div><p class="eyebrow">Research status</p><h2>Coverage gaps ({{ guide.metadata.coverage_gap_count }})</h2>
              <p>These organizations were investigated, but no usable published endorsement list
                was available. They do not contribute to consensus scores.</p></div>
            <div class="coverage-gap-columns">
              {% for source in coverage_gap_sources %}{{ coverage_gap_row(source) }}{% endfor %}
            </div>
          </section>
          {% endif %}

          {% if guide.personalization.policy.enabled %}
          <div class="sources-actions">
            <button type="button" class="sources-reset" data-sources-reset>Reset to defaults</button>
          </div>
          <p class="sources-version">Panel {{ guide.personalization.panel_version }} ·
            {{ guide.personalization.panel_hash[:12] }} · Data {{ guide.metadata.data_version }}.
            Equal weight: each checked source counts once regardless of category overlap, and a
            source's vote splits evenly across every candidate it names. Every change updates the
            page address live, so the address bar is always the shareable link.</p>
          {% endif %}
        </div>
      </details>
      <div class="screen-footer-meta">
        <span>Election {{ guide.metadata.election_date }} · Built {{ guide.metadata.generated_at.date().isoformat() }} · Data {{ guide.metadata.data_version }} · Code {{ guide.metadata.git_commit[:12] }}<br>
          Panel {{ guide.metadata.source_panel_id }} · {{ guide.metadata.source_panel_hash }}</span>
        <a class="detailed-footer-audit" href="{{ config.project_url }}">Source and audit files</a>
      </div>
    </footer>
  </main>

  <div class="print-guide">
    {% macro print_race(race) %}
    <article class="print-race">
      <div class="print-race-title">{{ race.race_label }}</div>
      <div class="print-race-result">
        <strong>{{ race.recommendation_label }}</strong>
        {% if race.percentage_whole is none %}
        <div class="print-meter print-meter-na"><b class="print-meter-label"><span class="print-meter-text">N/A</span></b></div>
        {% else %}
        <div class="print-meter" style="--meter-fill: {{ race.percentage_whole }}%">
          <b class="print-meter-label"><span class="print-meter-text">{{ race.percentage_label }}</span></b>
        </div>
        {% endif %}
      </div>
      {% set print_warnings = concise_warning_labels(race) %}
      <div class="print-race-context">
        {% for comparison in race.comparisons %}<span class="print-comparison">
          <b class="print-times-pick print-times-pick-{{ comparison.voter_tone }}"><span class="print-times-status">{{ comparison.print_status_label }}</span><span class="print-times-separator"> · </span><span class="print-times-choice">{{ comparison.print_choice_label }}</span></b>
        </span>{% endfor %}
        <span class="print-support print-support-full">{{ race.support_summary }}</span>
        <span class="print-support print-support-compact">{{ race.explicit_endorsement_count }} endorsers</span>
        {% if print_warnings %}<b class="print-compact-warning">{{ print_warnings[0] }}</b>{% endif %}
      </div>
      {% if print_warnings %}
      <div class="print-race-notes">
        <span>{{ print_warnings | join(' / ') }}</span>
      </div>{% endif %}
    </article>
    {% endmacro %}
    <section class="print-page print-page-one">
      <header class="print-header">
        <div>
          <p data-document-role="print-election-label">{{ election_display_label }}</p>
          <h1 data-document-role="print-title">Seattle Progressive Endorsement Guide</h1>
        </div>
        <div class="print-header-meta">{{ guide.metadata.election_date }}<br>
          {{ guide.metadata.published_race_count }} races · source details on page 2</div>
      </header>
      <p class="print-intro">Progressive-source consensus. Seattle Times choices are comparison only.
        Too few explicit endorsements are labeled; no recommendation is made from insufficient evidence.</p>
      <div class="print-races">
        {% set print_midpoint = (guide.metadata.published_race_count + 1) // 2 %}
        {% for print_column in range(2) %}
        {% set print_start = 0 if print_column == 0 else print_midpoint %}
        {% set print_end = print_midpoint if print_column == 0 else guide.metadata.published_race_count %}
        {% set print_position = namespace(value=0) %}
        {% set displayed_section = namespace(id='') %}
        <div class="print-race-column">
          {% for section in guide.sections %}
          {% set section_first = print_position.value %}
            {% for race in section.races %}
              {% if print_position.value >= print_start and print_position.value < print_end %}
                {% if displayed_section.id != section.id %}
                <h2 class="print-section-title">{{ section.label }}{% if print_position.value > section_first %} — continued{% endif %}</h2>
                {% set displayed_section.id = section.id %}
                {% endif %}
                {{ print_race(race) }}
              {% endif %}
              {% set print_position.value = print_position.value + 1 %}
            {% endfor %}
          {% endfor %}
        </div>
        {% endfor %}
      </div>
      <footer>Verify details and evidence in the responsive guide at
        <a href="{{ config.project_url }}">{{ config.project_url }}</a></footer>
    </section>

    <section class="print-page print-page-two">
      <header class="method-header">
        <p>Methodology and sources</p>
        <h1>How to read this guide</h1>
        <div>{{ guide.metadata.contributing_source_count }} contributing sources ·
          {{ guide.metadata.coverage_gap_count }} coverage gaps</div>
      </header>
      <div class="page-two-content">
        <div class="method-summary">
          <article>
            <h2>Read the meter</h2>
            <p><strong>The percentage is agreement, not a candidate grade.</strong> It is the
              leading choice's share among sources that explicitly endorsed in that race.</p>
            <p>The source count shows the sample behind that percentage.</p>
          </article>
          <article class="times-summary">
            <h2>Read the Times pill</h2>
            <p><b class="method-pill method-pill-agrees">Times agrees</b> same choice</p>
            <p><b class="method-pill method-pill-differs">Times differs</b> another choice</p>
            <p><b class="method-pill">Times · not covered</b> no captured pick</p>
          </article>
          <article>
            <h2>Counting and scope</h2>
            <p>Each organization has equal weight; multi-candidate endorsements split one point.
              No endorsement and missing coverage stay visible but do not enter the percentage.</p>
            <p>LD groups count on broader races they cover, but only their own district's
              legislative races. Your registration address determines your exact ballot.</p>
          </article>
        </div>

        <section class="source-panel">
          <div class="source-panel-heading">
            <div><p>Evidence directory</p><h2>Sources contributing to this guide</h2></div>
            <span>{{ contributing_sources | selectattr('panel_role', 'equalto', 'consensus') | list | length }} consensus ·
              {{ contributing_sources | selectattr('panel_role', 'equalto', 'comparison') | list | length }} Times comparison<br>
              Counts: endorsements/picks · split subset</span>
          </div>
          {% set source_categories = guide.methodology.source_categories %}
          {% set source_category_split = namespace(index=1, count=0, difference=contributing_sources | length) %}
          {% for category in source_categories %}
            {% set category_count = contributing_sources | selectattr('category', 'equalto', category.category) | list | length %}
            {% set source_category_split.count = source_category_split.count + category_count %}
            {% set difference = (contributing_sources | length - (2 * source_category_split.count)) | abs %}
            {% if not loop.last and difference < source_category_split.difference %}
              {% set source_category_split.index = loop.index %}
              {% set source_category_split.difference = difference %}
            {% endif %}
          {% endfor %}
          <div class="source-columns">
            {% for source_column in range(2) %}
            {% set category_start = 0 if source_column == 0 else source_category_split.index %}
            {% set category_end = source_category_split.index if source_column == 0 else source_categories | length %}
            <div class="source-column" data-source-column="{{ source_column + 1 }}">
              {% for category in source_categories[category_start:category_end] %}
              <section class="source-category-group" data-source-category-group="{{ category.category }}">
                <h3 data-source-category="{{ category.category }}">{{ category.label }}</h3>
                {% for source in contributing_sources if source.category == category.category %}
                  {{ source_row(source, true) }}
                {% endfor %}
              </section>
              {% endfor %}
            </div>
            {% endfor %}
          </div>
          {% if coverage_gap_sources %}
          <section class="print-coverage-gaps">
            <div class="print-coverage-gap-heading"><h3>Coverage gaps</h3><span>Investigated; not counted in consensus</span></div>
            <div class="coverage-gap-columns">
              {% for source in coverage_gap_sources %}{{ coverage_gap_row(source, true) }}{% endfor %}
            </div>
          </section>
          {% endif %}
        </section>

        <div class="method-notes">
          <article>
            <h2>Overlap and limitations</h2>
            <p>{% if guide.methodology.source_overlap_groups %}{% for group in guide.methodology.source_overlap_groups %}<strong>{{ group.label }}</strong>
              ({{ group.source_ids | length }}){% if not loop.last %}; {% endif %}{% endfor %}.
              {% else %}No possible overlap groups span multiple active sources.
              {% endif %}
              These relationships are disclosed, not deduplicated; each separately governed source
              keeps one vote. Organizations may update endorsements after capture.</p>
          </article>
          <article>
            <h2>Verify before voting</h2>
            <p>{{ guide.methodology.verification_instructions }} This guide aggregates
              endorsements; it is not independent candidate vetting.</p>
          </article>
        </div>
      </div>
      <footer class="page-two-footer">
        <span>Election {{ guide.metadata.election_date }} · Built {{ guide.metadata.generated_at.date().isoformat() }} · Data {{ guide.metadata.data_version }} · Code {{ guide.metadata.git_commit[:12] }}</span>
        <span>Panel {{ guide.metadata.source_panel_version }} · {{ guide.metadata.source_panel_hash[:12] }} · {{ guide.metadata.published_race_count }} races · <a href="{{ config.project_url }}">Source and audit files</a></span>
      </footer>
    </section>
  </div>


  <script type="application/json" id="lens-bindings">{{ {
    "panel_id": guide.metadata.source_panel_id,
    "panel_hash": guide.metadata.source_panel_hash,
    "data_version": guide.metadata.data_version,
    "scoring": {"configuration_id": guide.personalization.scoring.configuration_id},
    "policy": {
      "maximum_url_characters": guide.personalization.policy.maximum_url_characters
    },
    "categories": (
      lens_personalization.categories if guide.personalization.policy.enabled
      else (lens_personalization.categories | selectattr('panel_role', 'equalto', 'comparison') | list)
    ),
    "sources": (
      lens_personalization.sources if guide.personalization.policy.enabled
      else (lens_personalization.sources | selectattr('panel_role', 'equalto', 'comparison') | list)
    )
  } | tojson }}</script>
  {% if guide.personalization.policy.enabled %}
  <script type="application/json" id="lens-personalization">{{ lens_personalization | tojson }}</script>
  {% endif %}
  <script type="module">
{{ share_link_script | safe }}
{{ lens_url_script | safe }}
  {% if guide.personalization.policy.enabled %}
{{ lens_score_script | safe }}
{{ lens_migrate_script | safe }}
{{ lens_divergence_script | safe }}
  {% endif %}

  // Page glue for the merged sources tree. The codec (and, once enabled, the
  // scoring engine) above is inlined verbatim from its module, so the shipped
  // page and the Node tests share one implementation.
  const bindings = JSON.parse(document.querySelector('#lens-bindings').textContent);

  const shareGuideButton = document.querySelector('[data-share-guide]');
  const shareGuideStatus = document.querySelector('[data-share-guide-status]');
  shareGuideButton?.addEventListener('click', async () => {
    const value = window.location.href;
    const result = await shareOrCopyLink(value, document.title);
    if (!shareGuideStatus) return;
    if (result === 'copied') shareGuideStatus.textContent = 'Link copied.';
    else if (result === 'shared') shareGuideStatus.textContent = 'Share menu opened.';
    else if (result === 'failed') shareGuideStatus.textContent = `Copy failed. Link: ${value}`;
  });

  // Tallying categories and sources are empty while personalization is
  // disabled, so no tallying selection is possible here yet: a shared link
  // that carries one decodes as malformed and falls back to audited, which is
  // the intended behavior until the policy is enabled. The comparison
  // source/category stay present either way (issue 96/97), since showing the
  // comparison predates and is independent of the newer personalization
  // policy.
  const context = lensContext(bindings, bindings.data_version);
  const comparisonSourceCodes = new Set(
    bindings.sources.filter((item) => item.panel_role === 'comparison').map((item) => item.code),
  );
  const categoryMemberCodesByCode = new Map(
    bindings.categories.map((item) => [item.code, item.member_source_codes]),
  );

  const root = document.documentElement;
  const lensNotice = document.querySelector('[data-lens-notice]');
  const comparisonStatusLine = document.querySelector('[data-sources-comparison-status]');
  const clearLensNotice = () => {
    if (lensNotice) {
      lensNotice.hidden = true;
      lensNotice.textContent = '';
    }
  };

  /**
   * Every rendered checkbox for one source code. A multi-category source
   * repeats its own checkbox once per category it belongs to (issue 97), and
   * the comparison source's checkbox always exists regardless of the
   * personalization policy (issue 96); every copy of a code must always
   * agree, so a change to any one syncs every other.
   */
  const sourceInputsByCode = new Map();
  document.querySelectorAll('[data-sources-source]').forEach((input) => {
    const code = input.dataset.sourcesSource;
    if (!sourceInputsByCode.has(code)) sourceInputsByCode.set(code, []);
    sourceInputsByCode.get(code).push(input);
  });
  const isCodeChecked = (code) => sourceInputsByCode.get(code)?.[0]?.checked ?? false;
  const syncSourceCode = (code, checked) => {
    for (const input of sourceInputsByCode.get(code) ?? []) input.checked = checked;
  };
  const checkedComparisonSourceCodes = () => [...comparisonSourceCodes].filter(isCodeChecked).sort();

  /** The Times pill's own display toggle predates and is independent of the
   * personalization policy (issue 96), so this always runs regardless. */
  const applyComparisonVisibility = () => {
    const shown = checkedComparisonSourceCodes().length > 0;
    root.classList.toggle('show-times', shown);
    if (comparisonStatusLine) {
      comparisonStatusLine.textContent = shown
        ? 'Seattle Times comparison shown. Recommendations are unchanged.'
        : '';
    }
  };

  {% if guide.personalization.policy.enabled %}
  /**
   * Resolve one decoded fragment to live lens state plus a persistent
   * explanation, when one is warranted.
   *
   * A same-version link needs neither migration nor an explanation. A
   * `stale_version` link is resolved through issue 78's migration resolver,
   * with no origin snapshot: nothing about correct resolution depends on one
   * (a surviving code always names the same source or category it always
   * did), it only refines "removed" versus "unknown" reporting this guide
   * does not surface. A migration that must reject falls back to audited.
   * Every other non-lens status (`absent`, `legacy`, or an ordinary in-page
   * anchor the codec does not recognize, such as the skip link) carries no
   * lens explanation at all, so clicking around the page never manufactures
   * one.
   */
  const lensOutcome = (fragment) => {
    const decoded = decodeLensFragment(fragment, context);
    if (decoded.status === 'valid') return { state: decoded.state, notice: null };
    if (decoded.status === 'stale_version') {
      const migration = migrateLensState(decoded, personalization, null);
      if (migration.status === 'migrated') {
        return {
          state: migration.selection,
          notice: 'This link was written for an earlier published data version. '
            + 'It was migrated to the current panel, so results may differ from the original link.',
        };
      }
      return {
        state: null,
        notice: 'This link could not be migrated to the current published panel '
          + `(category ${migration.category} is no longer available), so it shows the audited consensus.`,
      };
    }
    if (decoded.status === 'absent' || decoded.status === 'legacy') return { state: null, notice: null };
    if (decoded.reason === 'unrecognized_fragment') return { state: null, notice: null };
    return {
      state: null,
      notice: 'This link could not be read, so it shows the audited consensus.',
    };
  };
  const lensState = () => lensOutcome(window.location.hash).state;
  {% else %}
  // The one place that decides which decode statuses carry live lens state.
  // Personalization is disabled here, so there is nothing yet to migrate a
  // stale-version link's selection into; only its Times flag is honored.
  const lensState = () => {
    const decoded = decodeLensFragment(window.location.hash, context);
    return decoded.status === 'valid' || decoded.status === 'stale_version'
      ? decoded.state
      : null;
  };
  {% endif %}
  const raceTarget = () => {
    const decoded = decodeLensFragment(window.location.hash, context);
    if (decoded.status === 'legacy') return decoded.raceTarget;
    return lensState()?.raceTarget ?? null;
  };

  {% if guide.personalization.policy.enabled %}
  const personalization = JSON.parse(document.querySelector('#lens-personalization').textContent);
  const categoryToggleInputs = [...document.querySelectorAll('[data-sources-category-toggle]')];
  const membersOfCategory = (categoryCode) => [
    ...document.querySelectorAll(
      `[data-sources-source][data-sources-category-member="${categoryCode}"]`,
    ),
  ];
  const lensBanner = document.querySelector('[data-lens-banner]');
  const resetButton = document.querySelector('[data-sources-reset]');
  const tallyingSourceCodes = [...sourceInputsByCode.keys()].filter(
    (code) => !comparisonSourceCodes.has(code),
  );
  const checkedTallyingSourceCodes = () => tallyingSourceCodes.filter(isCodeChecked).sort();
  const allCheckedSourceCodes = () => [...sourceInputsByCode.keys()].filter(isCodeChecked).sort();

  /**
   * Whether the tallying (scored) selection alone matches the full panel.
   * The Times comparison never tallies (issue 96/97), so whether it is
   * shown must never flip a race between its audited and personalized
   * presentation — only a tallying change can do that.
   */
  const isDefaultTallyingSelection = () =>
    checkedTallyingSourceCodes().length === tallyingSourceCodes.length;

  /**
   * The audited default: every tallying source checked, no comparison source
   * checked. Represented by the absence of a lens fragment (issue 97's own
   * "every checkbox starts checked" design), so the reset action and a link
   * naming nothing both reach exactly this same state. Comparison state
   * counts here (unlike isDefaultTallyingSelection above) because showing it
   * must still survive a reload or a shared link.
   */
  const isDefaultSelection = () =>
    isDefaultTallyingSelection() && checkedComparisonSourceCodes().length === 0;

  /** Reflect whether every, some, or no member of a category is checked onto
   * that category's own header checkbox: checked, indeterminate, or clear. */
  const updateCategoryToggleStates = () => {
    categoryToggleInputs.forEach((toggle) => {
      const categoryCode = toggle.dataset.sourcesCategoryToggle;
      const members = membersOfCategory(categoryCode);
      const checkedCount = members.filter((member) => member.checked).length;
      // An empty category is vacuously "fully checked": zero members can
      // never disagree with the checked default, so it must not flip the
      // header checkbox off just because it currently has nothing to list.
      toggle.checked = checkedCount === members.length;
      toggle.indeterminate = checkedCount > 0 && checkedCount < members.length;
    });
  };

  /**
   * Per-race presentation data the lens payload does not carry: candidate
   * display labels and source display names. Both already exist in the
   * server-rendered, audited-only DOM (the race detail dialog's candidate
   * headings and the sources tree's own rows), so this reads them once
   * rather than publishing a second copy through the lens payload.
   */
  const raceCards = new Map(
    [...document.querySelectorAll('[data-publication-race-id]')].map((card) => [
      card.dataset.publicationRaceId,
      card,
    ]),
  );
  const candidateLabelsByRaceId = new Map(
    [...raceCards.entries()].map(([raceId, card]) => [
      raceId,
      new Map(
        [...card.querySelectorAll('[data-race-detail-candidate-id]')].map((section) => [
          section.dataset.raceDetailCandidateId,
          section.querySelector('.race-detail-candidate-title h4')?.textContent
            ?? section.dataset.raceDetailCandidateId,
        ]),
      ),
    ]),
  );
  const sourceNameByCode = new Map(
    [...sourceInputsByCode.entries()].map(([code, inputs]) => [
      code,
      inputs[0]?.closest('[data-sources-source-row]')?.querySelector('a')?.textContent ?? code,
    ]),
  );
  const raceDataById = new Map(personalization.races.map((race) => [race.race_id, race]));

  // The full selectable panel with no direct picks reproduces the published
  // audited consensus exactly (lens-score.mjs's own tested contract), so
  // scoring it once gives every card a structured baseline to diff against
  // instead of a second, independently maintained copy of the audited
  // values.
  const auditedByRaceId = new Map(
    scoreSelection(personalization, {
      categoryCodes: personalization.categories.filter((item) => item.selectable).map((item) => item.code),
      sourceCodes: [],
    }).races.map((race) => [race.raceId, race]),
  );

  const percentageLabel = (shareString) => {
    if (shareString === null) return 'N/A';
    const share = Rational.parse(shareString);
    const scaledNumerator = share.numerator * 100n;
    const scaledDenominator = share.denominator;
    const whole = (scaledNumerator * 2n + scaledDenominator) / (2n * scaledDenominator);
    return `${whole}%`;
  };
  const shareAccessibleLabel = (shareString) =>
    `Consensus among explicitly endorsing sources: ${percentageLabel(shareString)}`;
  const recommendationLabel = (scored, labels) => {
    if (scored.grade === 'Insufficient') return 'Too few endorsements';
    if (scored.isTied) return scored.winnerIds.map((id) => labels.get(id) ?? id).join(' / ');
    return (scored.winnerId !== null ? labels.get(scored.winnerId) : null) ?? 'No consensus';
  };
  const supportSummary = (scored) =>
    `Based on ${scored.explicitCount} endorsing ${scored.explicitCount === 1 ? 'source' : 'sources'}`;
  const compactAuditedSummary = (audited, labels) =>
    `Audited consensus: ${recommendationLabel(audited, labels)} · ${percentageLabel(audited.winnerShare)}`;

  /**
   * Apply one race's personalized result to its card and detail dialog: the
   * personalized recommendation, share, source count, and insufficient-
   * evidence state always render while My sources is active; the compact
   * audited comparison and the detail panel's audited line render only when
   * this race actually diverges, so an unchanged race stays free of
   * redundant audited detail.
   */
  const coveredCellStates = new Set(['endorsement', 'multi_endorsement', 'no_endorsement']);

  const renderRaceLens = (raceId, card, personalizedByRaceId, resolvedSourceCodes) => {
    const personalized = personalizedByRaceId.get(raceId);
    const audited = auditedByRaceId.get(raceId);
    if (!personalized || !audited) return;
    const labels = candidateLabelsByRaceId.get(raceId) ?? new Map();
    const divergence = compareRaceResults(audited, personalized);

    const recommendationEl = card.querySelector('[data-lens-recommendation]');
    if (recommendationEl) recommendationEl.textContent = recommendationLabel(personalized, labels);
    const shareEl = card.querySelector('[data-lens-share-text]');
    if (shareEl) shareEl.textContent = percentageLabel(personalized.winnerShare);
    const shareMeter = card.querySelector('[data-lens-share]');
    if (shareMeter) {
      shareMeter.classList.toggle('screen-meter-na', personalized.winnerShare === null);
      shareMeter.style.setProperty(
        '--meter-fill',
        personalized.winnerShare === null ? '0%' : percentageLabel(personalized.winnerShare),
      );
      shareMeter.setAttribute('aria-label', shareAccessibleLabel(personalized.winnerShare));
    }
    const supportEl = card.querySelector('[data-lens-support]');
    if (supportEl) supportEl.textContent = supportSummary(personalized);
    const insufficientEl = card.querySelector('[data-lens-insufficient]');
    if (insufficientEl) insufficientEl.hidden = personalized.grade !== 'Insufficient';
    const comparisonEl = card.querySelector('[data-lens-comparison]');
    if (comparisonEl) {
      comparisonEl.hidden = !divergence.anyChanged;
      if (divergence.anyChanged) comparisonEl.textContent = compactAuditedSummary(audited, labels);
    }

    // Race detail: complete personalized values, the audited comparison when
    // divergent, and every contributing source.
    const summaryEl = card.querySelector('[data-lens-detail-summary]');
    if (summaryEl) {
      const flags = [
        personalized.isTied ? 'Tied' : null,
        personalized.grade === 'Insufficient' ? 'Insufficient evidence' : null,
        personalized.confidenceWarningCodes.length > 0 ? 'Confidence warning' : null,
      ].filter((flag) => flag !== null);
      summaryEl.textContent = [
        recommendationLabel(personalized, labels),
        percentageLabel(personalized.winnerShare),
        supportSummary(personalized),
        ...flags,
      ].join(' · ');
    }
    const auditedDetailEl = card.querySelector('[data-lens-detail-audited]');
    if (auditedDetailEl) {
      auditedDetailEl.hidden = !divergence.anyChanged;
      if (divergence.anyChanged) auditedDetailEl.textContent = compactAuditedSummary(audited, labels);
    }
    const sourcesEl = card.querySelector('[data-lens-detail-sources]');
    if (sourcesEl) {
      const race = raceDataById.get(raceId);
      // "Contributing" means this race actually has a cell to show for the
      // source: eligible, selected, and covered (an explicit endorsement or
      // an on-record no-pick), the same states lens-score.mjs's own coverage
      // set counts. A selected-but-not-covered source has nothing to list.
      sourcesEl.replaceChildren(
        ...(race?.cells ?? [])
          .filter(
            (cell) => resolvedSourceCodes.includes(cell.source_code) && coveredCellStates.has(cell.state),
          )
          .map((cell) => {
            const item = document.createElement('li');
            item.textContent = sourceNameByCode.get(cell.source_code) ?? cell.source_code;
            return item;
          }),
      );
    }
  };

  /**
   * Feed the checked tallying selection into the pure scoring engine, update
   * the reactive banner, and render every race card and detail dialog's
   * personalized presentation (issue 81), but only once it actually diverges
   * from the audited default (issue 97: no separate audited/sources mode
   * toggle — every checkbox starts checked, so the default reproduces the
   * audited consensus by construction and the banner/personalized rendering
   * activate only on an explicit change).
   */
  const recomputePersonalizedResults = () => {
    const personalized = !isDefaultTallyingSelection();
    root.classList.toggle('lens-personalized', personalized);
    if (!personalized) {
      if (lensBanner) lensBanner.hidden = true;
      return null;
    }
    const tallyingCodes = checkedTallyingSourceCodes();
    const results = scoreSelection(personalization, { categoryCodes: [], sourceCodes: tallyingCodes });
    if (lensBanner) {
      lensBanner.hidden = false;
      lensBanner.textContent =
        `Personalized lens active — ${results.sourceCodes.length} of `
        + `${tallyingSourceCodes.length} sources included.`;
    }
    const personalizedByRaceId = new Map(results.races.map((race) => [race.raceId, race]));
    raceCards.forEach((card, raceId) => {
      renderRaceLens(raceId, card, personalizedByRaceId, results.sourceCodes);
    });
    return results;
  };
  {% endif %}

  /** Every path that can change what the address bar encodes — a checkbox, a
   * category toggle, or reset — runs through here. */
  const refreshSelectionUi = () => {
    clearLensNotice();
    {% if guide.personalization.policy.enabled %}
    updateCategoryToggleStates();
    recomputePersonalizedResults();
    {% endif %}
    applyComparisonVisibility();
  };

  /**
   * Apply a decoded (or migrated) selection to every checkbox: a category
   * code expands to its current member codes (backward compatible with a
   * link shared before issue 97's per-source checkboxes existed), unioned
   * with any directly named source codes. Anything else stays unchecked.
   */
  const applySelection = (selection) => {
    const categoryMemberCodes = (selection?.categoryCodes ?? []).flatMap(
      (code) => categoryMemberCodesByCode.get(code) ?? [],
    );
    const effectiveCodes = new Set([...categoryMemberCodes, ...(selection?.sourceCodes ?? [])]);
    for (const code of sourceInputsByCode.keys()) {
      syncSourceCode(code, effectiveCodes.has(code));
    }
    refreshSelectionUi();
  };

  /**
   * Write the whole lens state (Times, and once enabled, mode and selection)
   * through the codec in one place, so the two concerns never race on the
   * same URL fragment.
   *
   * The audited baseline with the comparison hidden and no selection is the
   * published default, so it is represented by the absence of a lens
   * fragment: a default guide keeps the clean URLs and plain race permalinks
   * it has always had.
   */
  /**
   * Write the whole lens state through the codec in one place, so every
   * source checkbox's change and the URL never race. The audited default —
   * every tallying source checked, no comparison source checked — is the
   * published default, so it is represented by the absence of a lens
   * fragment: a default guide keeps the clean URLs and plain race permalinks
   * it has always had.
   */
  const writeLensState = () => {
    const target = raceTarget();
    {% if guide.personalization.policy.enabled %}
    const sourceCodes = allCheckedSourceCodes();
    const isDefault = isDefaultSelection();
    {% else %}
    const sourceCodes = checkedComparisonSourceCodes();
    const isDefault = sourceCodes.length === 0;
    {% endif %}
    if (isDefault) {
      const fragment = target ? `#${target}` : '';
      history.replaceState(
        history.state,
        '',
        `${window.location.pathname}${window.location.search}${fragment}`,
      );
      return;
    }
    const encoded = encodeLensFragment({ mode: 's', categoryCodes: [], sourceCodes, raceTarget: target }, context);
    if (encoded.status !== 'ok') return;
    history.replaceState(
      history.state,
      '',
      `${window.location.pathname}${window.location.search}#${encoded.fragment}`,
    );
  };

  {% if guide.personalization.policy.enabled %}
  // Computed once, from the page's initial location: a persistent migration
  // or invalid-link explanation describes how this load resolved a shared
  // link, not an ongoing in-page navigation, so later hashchange events
  // (including the skip link, which the codec deliberately does not
  // recognize as lens-shaped) never manufacture or overwrite it.
  const initialLensOutcome = lensOutcome(window.location.hash);
  // applySelection() (via refreshSelectionUi()) unconditionally clears any
  // existing notice, so the state must be applied before the notice text
  // below is set, not after — otherwise this very notice would erase itself
  // on the same load that produced it.
  if (initialLensOutcome.state !== null) {
    applySelection(initialLensOutcome.state);
  } else {
    updateCategoryToggleStates();
    recomputePersonalizedResults();
  }
  if (lensNotice && initialLensOutcome.notice) {
    lensNotice.hidden = false;
    lensNotice.textContent = initialLensOutcome.notice;
  }
  if (initialLensOutcome.state === null && initialLensOutcome.notice) {
    // A malformed or unmigratable link falls back to the audited consensus;
    // clear it from the address bar so a reload or copy reproduces that
    // resolved state instead of failing the same way again.
    history.replaceState(history.state, '', `${window.location.pathname}${window.location.search}`);
  }
  {% else %}
  // A malformed lens fragment must not linger in the address bar even though
  // nothing here reads its selection; a reload or copy must not reproduce it.
  // An ordinary in-page anchor (the skip link, a plain "#id") decodes the
  // same way but must survive untouched, matching the enabled branch's own
  // lensOutcome() exclusion for this exact reason.
  {
    const initialDecoded = decodeLensFragment(window.location.hash, context);
    if (initialDecoded.status === 'malformed' && initialDecoded.reason !== 'unrecognized_fragment') {
      history.replaceState(history.state, '', `${window.location.pathname}${window.location.search}`);
    }
  }
  const initialDisabledState = lensState();
  if (initialDisabledState !== null) applySelection(initialDisabledState);
  {% endif %}
  applyComparisonVisibility();

  document.querySelectorAll('[data-sources-source]').forEach((input) => {
    input.addEventListener('change', () => {
      syncSourceCode(input.dataset.sourcesSource, input.checked);
      refreshSelectionUi();
      writeLensState();
    });
  });
  {% if guide.personalization.policy.enabled %}
  categoryToggleInputs.forEach((toggle) => {
    toggle.addEventListener('change', () => {
      const categoryCode = toggle.dataset.sourcesCategoryToggle;
      const members = membersOfCategory(categoryCode);
      members.forEach((member) => syncSourceCode(member.dataset.sourcesSource, toggle.checked));
      refreshSelectionUi();
      writeLensState();
    });
  });
  resetButton?.addEventListener('click', () => {
    for (const code of tallyingSourceCodes) syncSourceCode(code, true);
    for (const code of comparisonSourceCodes) syncSourceCode(code, false);
    refreshSelectionUi();
    writeLensState();
  });
  {% endif %}
  // A plain in-page anchor (the skip link) also fires hashchange; the codec's
  // own absent/legacy/unrecognized_fragment classification already excludes
  // that case (lensState/lensOutcome return null), so this only ever reacts
  // to a genuine lens link.
  window.addEventListener('hashchange', () => {
    const state = lensState();
    if (!state) return;
    applySelection(state);
  });
  </script>
  <script>
  (() => {
    const initialQuery = new URLSearchParams(window.location.search);
    const edition = initialQuery.get('edition');
    if (edition === 'compact' || edition === 'detailed') {
      document.documentElement.classList.add(`${edition}-edition`);
    }
    if (edition === 'detailed') {
      document.querySelectorAll('.guide-notes').forEach(details => details.setAttribute('open', ''));
    }
    const centerPrintInk = () => {
      if (window.__disablePrintInkCentering) return;
      const printGuide = document.querySelector('.print-guide');
      if (!printGuide || getComputedStyle(printGuide).display === 'none') return;
      const context = document.createElement('canvas').getContext('2d');
      if (!context) return;
      const inkBounds = (element) => {
        const style = getComputedStyle(element);
        context.font = [style.fontStyle, style.fontWeight, style.fontSize, style.fontFamily]
          .join(' ');
        const text = [...element.childNodes]
          .filter((node) => node.nodeType === Node.TEXT_NODE)
          .map((node) => node.textContent).join('');
        const metrics = context.measureText(text);
        const marker = document.createElement('i');
        marker.style.cssText = 'display:inline-block;width:0;height:0;overflow:hidden;'
          + 'margin:0;padding:0;border:0;vertical-align:baseline';
        element.append(marker);
        const baseline = marker.getBoundingClientRect().top;
        marker.remove();
        return {
          top: baseline - metrics.actualBoundingBoxAscent,
          bottom: baseline + metrics.actualBoundingBoxDescent,
        };
      };
      const center = (container, elements, paddingTarget = container) => {
        paddingTarget.style.removeProperty('padding-top');
        paddingTarget.style.removeProperty('padding-bottom');
        for (let attempt = 0; attempt < 4; attempt += 1) {
          const bounds = elements.map(inkBounds);
          const containerRect = container.getBoundingClientRect();
          const inkTop = Math.min(...bounds.map((bound) => bound.top));
          const inkBottom = Math.max(...bounds.map((bound) => bound.bottom));
          const imbalance = (inkTop - containerRect.top) -
            (containerRect.bottom - inkBottom);
          if (Math.abs(imbalance) < .05) break;
          const offset = -imbalance / 2;
          const style = getComputedStyle(paddingTarget);
          paddingTarget.style.paddingTop =
            `${(Number.parseFloat(style.paddingTop) + offset).toFixed(3)}px`;
          paddingTarget.style.paddingBottom =
            `${(Number.parseFloat(style.paddingBottom) - offset).toFixed(3)}px`;
        }
      };
      document.querySelectorAll('.print-meter').forEach((meter) => {
        const text = meter.querySelector('.print-meter-text');
        const label = meter.querySelector('.print-meter-label');
        if (text && label) center(meter, [text], label);
      });
      document.querySelectorAll('.print-times-pick').forEach((pill) => {
        center(pill, [...pill.querySelectorAll(':scope > span')]);
      });
      document.documentElement.dataset.printInkCentered = 'true';
    };
    const printMedia = window.matchMedia('print');
    const calibratePrintInk = () => {
      if (!printMedia.matches) return;
      if (document.fonts.status === 'loaded') {
        centerPrintInk();
      } else {
        document.fonts.ready.then(() => {
          if (printMedia.matches) centerPrintInk();
        });
      }
    };
    window.addEventListener('beforeprint', calibratePrintInk);
    printMedia.addEventListener('change', (event) => {
      if (event.matches) {
        requestAnimationFrame(() => requestAnimationFrame(calibratePrintInk));
      }
    });
    calibratePrintInk();

    const select = document.querySelector('#race-filter');
    const completeFilter = document.querySelector('#complete-filter');
    const viewInputs = [...document.querySelectorAll('input[name="ballot-view"]')];
    const raceSetInputs = [...document.querySelectorAll('input[name="race-set"]')];
    const status = document.querySelector('#filter-status');
    const cards = [...document.querySelectorAll('[data-publication-race-id]')];
    const sections = [...document.querySelectorAll('[data-filter-section]')];
    const filterValues = new Set([...select.options].map((option) => option.value));
    const selectedView = () => viewInputs.find((input) => input.checked)?.value === 'compact'
      ? 'compact' : 'full';
    const selectedRaceSet = () => raceSetInputs.find((input) => input.checked)?.value === 'contested'
      ? 'contested' : 'complete';
    const syncControlsFromUrl = () => {
      const query = new URLSearchParams(window.location.search);
      const requestedFilter = query.get('filter');
      select.value = requestedFilter && filterValues.has(requestedFilter) ? requestedFilter : 'all';
      const requestedView = query.get('view') === 'compact' ? 'compact' : 'full';
      viewInputs.forEach((input) => { input.checked = input.value === requestedView; });
      const requestedRaceSet = query.get('races') === 'contested' ? 'contested' : 'complete';
      raceSetInputs.forEach((input) => { input.checked = input.value === requestedRaceSet; });
    };
    const writeControlState = () => {
      const url = new URL(window.location.href);
      if (select.value === 'all') url.searchParams.delete('filter');
      else url.searchParams.set('filter', select.value);
      if (selectedView() === 'compact') url.searchParams.set('view', 'compact');
      else url.searchParams.delete('view');
      if (selectedRaceSet() === 'contested') url.searchParams.set('races', 'contested');
      else url.searchParams.delete('races');
      history.replaceState(
        history.state,
        '',
        `${url.pathname}${url.search}${url.hash}`,
      );
    };
    const applyFilter = ({ syncUrl = true } = {}) => {
      const token = select.value;
      const contestedOnly = selectedRaceSet() === 'contested';
      const compact = selectedView() === 'compact';
      let visible = 0;
      document.documentElement.classList.toggle('compact-ballot-mode', compact);
      document.documentElement.dataset.ballotView = compact ? 'compact' : 'full';
      cards.forEach((card) => {
        const matchesScope = token === 'all' || JSON.parse(card.dataset.filterTokens).includes(token);
        const matchesContest = !contestedOnly || card.dataset.contested === 'true';
        const matches = matchesScope && matchesContest;
        card.hidden = !matches;
        if (matches) visible += 1;
      });
      sections.forEach((section) => {
        section.hidden = ![...section.querySelectorAll('[data-publication-race-id]')]
          .some((card) => !card.hidden);
      });
      const raceNoun = contestedOnly
        ? (visible === 1 ? 'contested race' : 'contested races')
        : (visible === 1 ? 'race' : 'races');
      const viewLabel = compact ? 'Compact' : 'Full';
      const scopeLabel = select.selectedOptions[0]?.textContent.trim() || 'All Seattle ballot races';
      const statusParts = [`${visible} ${raceNoun} shown`, viewLabel, scopeLabel];
      status.replaceChildren(...statusParts.map((part, index) => {
        const chunk = document.createElement('span');
        chunk.className = 'filter-status-part';
        chunk.textContent = index === 0 ? part : `· ${part}`;
        return chunk;
      }));
      if (syncUrl) writeControlState();
    };
    select.addEventListener('change', () => applyFilter());
    raceSetInputs.forEach((input) => input.addEventListener('change', () => applyFilter()));
    viewInputs.forEach((input) => input.addEventListener('change', () => applyFilter()));
    syncControlsFromUrl();
    applyFilter({ syncUrl: false });

    const dialogs = [...document.querySelectorAll('[data-race-detail-dialog]')];
    let lastTrigger = null;
    const fragmentId = () => {
      try {
        const raw = decodeURIComponent(window.location.hash.slice(1));
        // A lens fragment carries its race target in `race`. Only the element to
        // scroll to is extracted here; the codec module owns validating lens state.
        if (raw.includes('=')) return new URLSearchParams(raw).get('race') ?? '';
        return raw;
      } catch {
        return '';
      }
    };
    const openerFor = (dialog) => {
      const card = dialog.closest('[data-publication-race-id]');
      if (lastTrigger && lastTrigger.closest('[data-publication-race-id]') === card) {
        return lastTrigger;
      }
      return card?.querySelector('[data-race-detail-link]');
    };
    const syncRaceDetail = ({ restoreFocus = false } = {}) => {
      const card = document.getElementById(fragmentId());
      const target = card?.matches('[data-publication-race-id]')
        ? card.querySelector('[data-race-detail-dialog]') : null;
      dialogs.forEach((dialog) => {
        if (dialog !== target && dialog.open) dialog.close();
      });
      if (target) {
        if (card.hidden) {
          select.value = 'all';
          completeFilter.checked = true;
          applyFilter();
        }
        if (!target.open) target.showModal();
        target.querySelector('[data-close-race-detail]')?.focus();
        return;
      }
      if (restoreFocus && lastTrigger) lastTrigger.focus();
    };
    const requestClose = (dialog) => {
      const card = dialog.closest('[data-publication-race-id]');
      const fragment = card ? `#${card.id}` : '';
      if (fragment && window.location.hash === fragment && history.state?.raceDetail === fragment) {
        history.back();
        return;
      }
      history.replaceState(history.state, '', `${window.location.pathname}${window.location.search}`);
      if (dialog.open) dialog.close();
      openerFor(dialog)?.focus();
    };
    document.querySelectorAll('[data-race-detail-link]').forEach((link) => {
      link.addEventListener('click', (event) => {
        event.preventDefault();
        lastTrigger = link;
        const state = history.state && typeof history.state === 'object' ? history.state : {};
        history.pushState({ ...state, raceDetail: link.hash }, '', link.hash);
        syncRaceDetail();
      });
    });
    dialogs.forEach((dialog) => {
      dialog.querySelector('[data-close-race-detail]')?.addEventListener('click', () => {
        requestClose(dialog);
      });
      dialog.addEventListener('cancel', (event) => {
        event.preventDefault();
        requestClose(dialog);
      });
    });
    window.addEventListener('popstate', () => {
      syncControlsFromUrl();
      applyFilter({ syncUrl: false });
      syncRaceDetail({ restoreFocus: !window.location.hash });
    });
    window.addEventListener('hashchange', () => {
      syncRaceDetail({ restoreFocus: !window.location.hash });
    });
    document.querySelectorAll('[data-copy-race-link]').forEach((button) => {
      button.addEventListener('click', async () => {
        const originalLabel = button.dataset.originalLabel || button.textContent;
        button.dataset.originalLabel = originalLabel;
        const link = new URL(window.location.href);
        link.hash = button.dataset.copyRaceLink;
        const value = link.toString();
        try {
          if (navigator.clipboard?.writeText) {
            await navigator.clipboard.writeText(value);
          } else {
            const field = document.createElement('textarea');
            field.value = value;
            field.setAttribute('readonly', '');
            field.className = 'visually-hidden';
            document.body.append(field);
            field.select();
            const copied = document.execCommand('copy');
            field.remove();
            if (!copied) throw new Error('Copy command was unavailable');
          }
          const raceLabel = button.closest('[data-publication-race-id]')
            ?.querySelector('[data-display-role="race-label"]')?.textContent?.trim();
          const copyStatus = button.closest('[data-race-detail-dialog]')
            ?.querySelector('[data-copy-race-status]');
          if (copyStatus) copyStatus.textContent = `Link copied for ${raceLabel || 'this race'}`;
          button.textContent = 'Link copied';
        } catch {
          const copyStatus = button.closest('[data-race-detail-dialog]')
            ?.querySelector('[data-copy-race-status]');
          if (copyStatus) copyStatus.textContent = `Copy failed. Link: ${value}`;
          button.textContent = 'Copy failed';
        }
        window.setTimeout(() => { button.textContent = originalLabel; }, 1800);
        button.focus();
      });
    });
    syncRaceDetail();
  })();
  </script>
</body>
</html>
