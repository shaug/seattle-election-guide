{% extends 'base.html.j2' %}
{% block head_meta %}
  {% set canonical_url = config.public_site_url ~ '/e/' ~ guide.metadata.election_id ~ '/' %}
  <meta name="author" content="{{ config.author }}">
  {{ shell.social_meta(document_title, config.subject, canonical_url) }}
{% endblock %}
{% block body %}
  {% from '_filter_controls.html.j2' import election_controls %}
  {% from '_meter.html.j2' import segmented_meter %}
  {% from '_results.html.j2' import result_block %}
  {% set contributing_sources = guide.sources | selectattr('contribution_status', 'equalto', 'contributing') | list %}
  {% set consensus_source_count = contributing_sources | selectattr('panel_role', 'equalto', 'consensus') | list | length %}
  <a class="skip-link" href="#guide-races">Skip to recommendations</a>

  <main class="page screen-guide">
    {{ shell.band(guide_href=guide_path, sources_href=sources_page_url, compare_href=compare_href, corrections_href=corrections_href, current='endorsements', sources_link_data_attribute=true) }}
    {%+ call shell.page_head('Endorsements', eyebrow=election_display_name, mode='extended') %}Seattle&rsquo;s progressive voices, distilled.{% endcall +%}
    <div class="page-band-rule"></div>
    {{ election_day_banner | safe }}

    <div class="sticky-header">
      {% call election_controls(
        'Guide view and race filters', 'screen-controls',
        'race-filter', '', 'race-filter-control',
        'ballot-view', [
          {'value': 'full', 'label': 'Full', 'id': '', 'attributes': '', 'checked': true},
          {'value': 'compact', 'label': 'Compact', 'id': '', 'attributes': '', 'checked': false}
        ],
        'race-set', [
          {'value': 'complete', 'label': 'All', 'id': 'complete-filter', 'attributes': '', 'checked': true},
          {'value': 'contested', 'label': 'Contested', 'id': 'contested-filter', 'attributes': '', 'checked': false}
        ],
        'filter-status'
      ) %}
        {# Rendered from the same `filter_scope_groups` the payload publishes
           flattened, so the status line can name the selected scope without
           reading this select's own text back (docs/FRONTEND.md, The data
           contract). #}
        {% for group in filter_scope_groups %}
        {% if group.label %}<optgroup label="{{ group.label }}">{% endif %}
        {% for option in group.options %}<option value="{{ option.value }}">{{ option.label }}</option>{% endfor %}
        {% if group.label %}</optgroup>{% endif %}
        {% endfor %}
      {% endcall %}

      {# The lens strip's two announcing elements are the server's for the life
         of the page (docs/FRONTEND.md § Rendering): lit renders their text,
         never the elements themselves, because a live region only announces a
         change if it was already in the accessibility tree when the change
         happened — and one that is created and filled in the same task was
         not. #}
      {% if guide.personalization.policy.enabled %}
      <div class="lens-banner state-action-strip" data-lens-banner>
        <span data-lens-banner-status role="status" aria-live="polite">Counting all {{ consensus_source_count }} sources.</span>
        <a data-sources-link href="{{ sources_page_url }}">Edit sources</a>
      </div>
      {% endif %}
      {# Outside the policy branch: a fragment this build cannot read is
         reported to the reader whether or not the lens is enabled, and an
         unwritable Sources link is reported here too. A cleaned address bar
         without a notice is the defect the rule names (docs/FRONTEND.md
         § State and URLs). #}
      <p class="lens-notice" data-lens-notice hidden role="status" aria-live="polite"></p>
      {# Revealed only when the embedded payload cannot be read or names a
         schema version this build does not understand; the audited page
         below stands unchanged (docs/FRONTEND.md, The data contract). #}
      <p class="lens-notice" data-payload-notice hidden role="status" aria-live="polite"></p>
    </div>

    <div id="guide-races" class="screen-sections">
      {% for section in guide.sections %}
      <section class="screen-section" data-filter-section="{{ section.id }}">
        <div class="section-heading">
          <h2>{{ section.label }}</h2>
        </div>
        <div class="race-grid">
          {% for race in section.races %}
          <article class="race-card" id="race-{{ race.id }}"
            data-publication-race-id="{{ race.id }}"
            data-contested="{{ 'true' if race.is_contested else 'false' }}"
            aria-labelledby="race-label-{{ race.id }}"
            data-filter-tokens='{{ race.filter_tokens | tojson }}'>
            {# The card's core recommendation area is an ordinary link to the
               race's own page (issue #136). It opened a dialog over the guide
               until race detail became something a reader lands on, shares, and
               unfurls, which is what DESIGN.md's page-vs-modal test turns on.
               The card keeps its `id`, so a `#race-…` link already out in the
               world still scrolls to this card for a reader without
               JavaScript; with JavaScript, `guide-client.mjs` forwards it to
               the page. #}
            <a class="race-card-primary" href="{{ race_page_path(race.id) }}"
              aria-label="View endorsements for {{ race.race_label }}">
              <p class="race-office">
                <span id="race-label-{{ race.id }}"
                  data-display-role="race-label">{{ race.race_label }}</span>
              </p>
              {# Three lens regions, each one element the server already had
                 (docs/FRONTEND.md § Rendering). Where this markup used to
                 carry an audited element and an empty lens-only twin beside it
                 for every value, it now carries one element whose children
                 guide-card.mjs renders — from the audited view model until a
                 selection diverges, from the personalized one afterwards. #}
              <div class="screen-race-result" data-lens-result>
                <h3 data-display-role="recommendation">{{ race.recommendation_label }}</h3>
                {{ segmented_meter(meter_view(race)) }}
              </div>
              {# I39: the primary block ends with the caption directly under
                 the meter row; the reference block (the All-sources bar)
                 renders at the card foot below, after the insufficiency
                 warning, never interleaved with this caption. #}
              <div class="screen-race-context" data-lens-context>
                <p class="no-majority-pill"{% if not has_no_majority(race) %} hidden{% endif %}>No majority</p>
                <p class="support-line support-full" data-display-role="support">{{ screen_support_summary(race) }}</p>
                <p class="support-line support-compact" data-display-role="support">{{ screen_support_summary_compact(race) }}</p>
              </div>
            </a>
            {# The card foot (I39): the insufficiency warning, then the
               All-sources reference bar. `display: contents` (guide.css), so
               the wrapper gives lit one region to own without becoming a box
               of its own — both blocks stay direct flex items of the card and
               keep the gap between them. The audited baseline renders the
               warning alone, and only for a race that has one; the reference
               bar is divergence-only, so nothing stands empty here waiting to
               be filled in. #}
            <div class="race-card-foot" data-lens-foot>
              {% if race.grade == 'Insufficient' %}
              <div class="insufficient-note" role="note" data-display-role="insufficient-warning">
                Too few endorsements to measure agreement.</div>
              {% endif %}
            </div>
            {# The results strip (docs/RESULTS.md, Rendering § Race cards;
               #286, extended to measures by #348): outside every lens region
               above, because a certified result is a permanent fact the
               reader's source selection never changes. `race_results(race)`
               (rendering/context.py) renders the identical tally-row markup
               for a measure's Yes/No outcomes as it does for a candidate
               race's -- `results` alone decides the certified branch below,
               regardless of race type. #}
            {% set results = race_results(race) %}
            {% if results %}
            {# Certified: a permanent fact once ingested, so it renders
               directly and unconditionally -- no script involvement needed,
               exactly like the banner's own certified state. #}
            {{ result_block(results) }}
            {% endif %}
          </article>
          {% endfor %}
        </div>
      </section>
      {% endfor %}
    </div>

    <footer class="site-footer">
      {{ shell.election_footer_band(project_url, guide.metadata, guide_path, footer_data_updated_date, footer_site_updated_date) }}
    </footer>
  </main>
{% endblock %}
{% block scripts %}

  {# One payload element per page, built by rendering/payload.py from the
     Pydantic models the client's declarations are generated from
     (docs/FRONTEND.md, The data contract). #}
  <script type="application/json" data-client-payload>{{ client_payload | tojson }}</script>
  <script type="module">
{{ guide_entry_script | safe }}
  GuidePage.boot();
  </script>
{% endblock %}
