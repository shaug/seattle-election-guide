{% extends 'base.html.j2' %}
{% block head_meta %}
  <meta name="robots" content="noindex">
  {% set canonical_url = public_site_url ~ guide_path ~ 'sources/' %}
  {% set page_description = 'Choose which sources count toward your personalized ' ~ election_display_name ~ ' results.' %}
  {{ shell.social_meta(document_title, page_description, canonical_url) }}
{% endblock %}
{% block styles %}
  <style>
    {{ stylesheet | safe }}
    main { padding: 1.5rem clamp(1rem, 4vw, 2.5rem) 3rem; }
    .sources-tree { border-top: none; background: none; padding: 0; }
    .sources-page-actions { position: sticky; top: 0; z-index: 5; justify-content: center; }
    .sources-page-controls { display: flex; flex-wrap: wrap; justify-content: center; gap: .45rem 1rem; }
    .sources-page-actions a { color: var(--mint); font-weight: 700; }
    .sources-page-actions .strip-action-primary {
      display: inline-flex; align-items: center; padding: .16rem .7rem;
      border-radius: 999px; background: var(--mint); color: var(--navy);
      font-weight: 800; line-height: 1; text-decoration: none;
    }
    .sources-page-actions .strip-action-primary:hover { filter: brightness(1.06); }
    .sources-page-actions .strip-action-quiet { color: var(--sky); font-weight: 600; }
    .sources-page-count { margin: 0; color: var(--white); font-size: .9rem; font-weight: 600; }
  </style>
{% endblock %}
{% block body %}
  {% macro coverage_gap_row(source, compact=false) -%}
    <section class="coverage-gap-row"
      data-coverage-gap-source-id="{{ source.id }}"
      data-coverage-gap-status="{{ source.coverage_gap_status }}">
      <div><a href="{{ source.evidence_url }}"{{ external_link_attributes }}>{{ source.name }}</a>
        <strong>{% if source.coverage_gap_status == 'access_restricted' %}Official results inaccessible{% else %}No published results found{% endif %}</strong></div>
      {% if not compact %}<p>{{ source.coverage_gap_note }}</p>{% endif %}
    </section>
  {%- endmacro %}
  {% macro sources_member_row(category, member_code) -%}
    {% set psource = personalization_source_by_code[member_code] %}
    {% set pub_source = source_by_id[psource.id] %}
    {# Issue 124: a comparison source is documented here but is no longer
       checkable anywhere — the guide has no comparison to show, and choosing
       comparison columns is the Comparisons page's job. Its row keeps the
       name, the evidence link, and the endorsement overview. #}
    {% set is_comparison = category.panel_role == 'comparison' %}
    {# A source with zero endorsements this cycle (a coverage gap) has
       nothing an interactive checkbox could ever toggle into a score, so it
       stays out of this tree entirely and appears only in the coverage-gaps
       section below, matching the guide's own "contributing" filter. #}
    {% if pub_source.contribution_status == 'contributing' %}
    {% set other_category_ids = psource.selection_category_ids | reject('equalto', category.id) | list %}
    <div class="sources-row" data-sources-source-row="{{ member_code }}">
      {% if guide.personalization.policy.enabled and not is_comparison %}
      <label class="sources-check">
        <input type="checkbox" data-sources-source="{{ member_code }}"
          data-sources-category-member="{{ category.code }}" checked>
        <a href="{{ pub_source.evidence_url }}"{{ external_link_attributes }}>{{ pub_source.name }}</a>
      </label>
      {% else %}
      <a class="sources-source-link" href="{{ pub_source.evidence_url }}"{{ external_link_attributes }}>{{ pub_source.name }}</a>
      {% endif %}
      <span class="sources-count">{{ source_participation_label(pub_source) }}</span>
      {% if other_category_ids %}
      <span class="sources-also-in">also in:
        {%- for other_id in other_category_ids %} {{ category_label_by_id[other_id] }}{% if not loop.last %},{% endif %}{% endfor -%}
      </span>
      {% endif %}
    </div>
    {% endif %}
  {%- endmacro %}

  {% set coverage_gap_sources = guide.sources | selectattr('contribution_status', 'equalto', 'coverage_gap') | list %}
  <a class="skip-link" href="#sources-main">Skip to content</a>
  <div class="page">
    <header>
      {{ shell.band(guide_href=guide_path, sources_href=guide_path ~ 'sources/', compare_href=compare_href, current='sources') }}
      <div class="page-band-rule"></div>
    </header>
    {{ election_day_banner | safe }}
    {%+ call shell.page_head('Sources', eyebrow=election_display_name) %}Choose which sources count &mdash; the guide recalculates from your selection.{% endcall +%}
    <div class="sources-page-actions state-action-strip">
      {# The audited count, rendered rather than left for the client to fill in:
         the page has to stand alone without JavaScript, and the region has to
         hold the same text on both sides for the parity check to mean anything
         (docs/FRONTEND.md § Rendering). "Counting", not "Viewing": a checked
         source counts toward the computed results (issue 115, item D17). #}
      <p class="sources-page-count" data-sources-count role="status" aria-live="polite">Counting {{ counted_source_count }} of {{ counted_source_count }} sources.</p>
      <div class="sources-page-controls">
        <a class="sources-save strip-action-primary" data-sources-save href="{{ guide_path }}">Save</a>
        <a class="sources-cancel" data-sources-cancel href="{{ guide_path }}">Cancel</a>
        <a class="sources-page-reset strip-action-quiet" data-sources-page-reset href="{{ guide_path }}">Reset to defaults</a>
      </div>
    </div>
    {# Revealed only when the embedded payload cannot be read or names a schema
       version this build does not understand; the server-rendered tree below
       stands unchanged (docs/FRONTEND.md, The data contract). #}
    <p class="lens-notice" data-payload-notice hidden role="status" aria-live="polite"></p>
    {# The fragment's own failures: an incoming link this build cannot read, and
       a selection too large to write into the Save link. Both used to fall
       through in silence (docs/FRONTEND.md § State and URLs). #}
    <p class="lens-notice" data-sources-notice hidden role="status" aria-live="polite"></p>
    <main id="sources-main">

      <div class="sources-tree">
        {# The selection region (docs/FRONTEND.md § Rendering). Only the
           selectable categories: the comparison-only section below carries no
           checkbox, and the coverage-gaps section carries no source a
           selection can reach, so neither is a projection of selection state
           and both stay as the server rendered them. sources-tree.mjs renders
           this region's children, and `sources-markup-parity.test.mjs` holds
           what it renders to the markup below. #}
        <div class="sources-columns" data-sources-tree>
          {% for category in guide.personalization.categories if category.selectable and category.panel_role != 'comparison' %}
          <section class="sources-category" data-sources-category="{{ category.code }}">
            <h2>
              {% if guide.personalization.policy.enabled %}
              <label class="sources-check sources-category-check">
                <input type="checkbox" data-sources-category-toggle="{{ category.code }}" checked>
                <span>{{ category.label }}</span>
              </label>
              {% else %}
              <span>{{ category.label }}</span>
              {% endif %}
            </h2>
            {% for member_code in category.member_source_codes %}
              {{ sources_member_row(category, member_code) }}
            {% endfor %}
          </section>
          {% endfor %}
        </div>

        {% set comparison_category = guide.personalization.categories | selectattr('panel_role', 'equalto', 'comparison') | first %}
        {% if comparison_category %}
        <section class="sources-category sources-category-comparison" data-sources-category="{{ comparison_category.code }}">
          <h2><span>Comparison only</span></h2>
          <p class="sources-comparison-note">Never counted toward the scores. Every source here is
            available on the {% if compare_href %}<a href="{{ compare_href }}">Comparisons page</a>{% else %}Comparisons page{% endif %},
            where you can put it side by side with the consensus.</p>
          {% for member_code in comparison_category.member_source_codes %}
            {{ sources_member_row(comparison_category, member_code) }}
          {% endfor %}
        </section>
        {% endif %}

        {% if coverage_gap_sources %}
        <section class="screen-coverage-gaps">
          <div><p class="eyebrow eyebrow-paper">Research status</p><h2>Coverage gaps ({{ guide.metadata.coverage_gap_count }})</h2>
            <p>We looked for endorsement lists from these organizations and found none we could
              use. They don&rsquo;t count toward any score.</p>
            {% if guide.personalization.policy.enabled %}<p class="coverage-gap-method">Every checked source counts once, with equal weight. When a
              source endorses more than one candidate in a race, its vote splits evenly among
              them.</p>{% endif %}</div>
          <div class="coverage-gap-columns">
            {% for source in coverage_gap_sources %}{{ coverage_gap_row(source) }}{% endfor %}
          </div>
        </section>
        {% endif %}

      </div>
    </main>
    <footer class="site-footer">
      {% if project_url is not none %}{{ shell.election_footer_band(project_url, guide.metadata, guide_path, footer_data_updated_date, footer_site_updated_date) }}{% endif %}
    </footer>
  </div>
{% endblock %}
{% block scripts %}

  {# One payload element per page, built by rendering/payload.py from the
     Pydantic models the client's declarations are generated from
     (docs/FRONTEND.md, The data contract). #}
  <script type="application/json" data-client-payload>{{ client_payload | tojson }}</script>

  <script type="module">
{{ sources_entry_script | safe }}
  SourcesPage.boot();
  </script>
{% endblock %}
