<div class="precinct-control" data-precinct-control hidden>
  <div class="precinct-summary" data-precinct-summary></div>
  <p class="precinct-status" data-precinct-applied-notice role="status" aria-live="polite" hidden></p>
  <dialog id="precinct-dialog" class="precinct-dialog" aria-labelledby="precinct-dialog-title">
    <form data-precinct-form>
      <a class="precinct-info" href="{{ precinct_lookup_href }}" target="_blank" rel="noopener noreferrer" aria-label="Find your precinct on the county map{{ opens_in_new_tab }}" title="Find your precinct on the county map{{ opens_in_new_tab }}">{{ info_icon_svg() }}</a>
      <h2 id="precinct-dialog-title">Select a precinct</h2>
      <div data-precinct-fields></div>
      <p class="precinct-status" data-precinct-status role="status" aria-live="polite"></p>
      <div data-precinct-clear-slot></div>
      <div class="precinct-actions">
        <button type="submit" data-precinct-submit></button>
        <button type="button" data-precinct-cancel>Cancel</button>
      </div>
    </form>
  </dialog>
</div>
