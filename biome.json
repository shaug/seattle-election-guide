{
  "$schema": "https://biomejs.dev/schemas/2.5.8/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "ignoreUnknown": false,
    "includes": ["src/election_guide/rendering/templates/**/*.mjs", "tests/js/**/*.mjs"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "trailingCommas": "all",
      "semicolons": "always",
      "arrowParentheses": "always"
    }
  },
  "linter": {
    "enabled": true,
    "rules": { "preset": "recommended" }
  },
  "assist": {
    "enabled": true,
    "actions": { "source": { "organizeImports": "on" } }
  },
  "overrides": [
    {
      "includes": ["tests/js/**/*.mjs"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["happy-dom", "happy-dom/**"],
                    "message": "Use installDom() from tests/js/support/dom.mjs (docs/FRONTEND.md § Testing)."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["tests/js/support/dom.mjs"],
      "linter": { "rules": { "style": { "noRestrictedImports": "off" } } }
    }
  ]
}
